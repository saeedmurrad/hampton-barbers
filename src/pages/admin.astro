---
import Base from '../layouts/Base.astro';
import { designs } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Hampton Barbers admin: prices and shop updates" description="Edit prices, special hours and notices.">
  <main id="main" class="adm">
    <header class="adm__top">
      <div>
        <a class="adm__back" href={`${base}/`}>← All designs</a>
        <h1>Prices and shop updates</h1>
      </div>
      <div class="adm__pub">
        <p id="status" role="status" aria-live="polite">Loading prices and shop updates…</p>
        <button type="button" id="publish" class="primary" disabled>Publish to the website</button>
      </div>
    </header>

    <section class="acct" id="account" aria-label="Your account"></section>

    <p class="adm__note">Your edits are kept as a <strong>draft on this device</strong> until you press <strong>Publish to the website</strong>. Visitors see the new prices and shop updates after publication.</p>

    <div id="editor"></div>

    <section class="cat" aria-labelledby="visit-settings-title" inert>
      <h2 id="visit-settings-title">Special hours and shop notice</h2>
      <p class="visit-help">Add a date for a bank holiday, temporary hours or a closure. Hours use UK local time.</p>
      <label>Shop notice <textarea id="shop-notice" maxlength="280" rows="2" placeholder="Optional message for the visit section"></textarea></label>
      <div id="hours-editor"></div>
      <button type="button" class="add" id="add-hours">+ Add a date</button>
    </section>

    <footer class="adm__foot">
      <div class="adm__see">
        <span>Preview your draft on:</span>
        {designs.map((d) => <a href={`${base}/${d.id}/#prices`}>{d.name}</a>)}
      </div>
      <div class="adm__ops">
        <button type="button" id="export">Download price list</button>
        <button type="button" id="reset" class="danger">Discard my drafts</button>
      </div>
    </footer>
  </main>
</Base>

<script>
  import { menu as defaults, type Category } from '../data/site';
  import { STORE_KEY, fetchLive } from '../lib/menu';
  import { parseVisit, validOverride, VISIT_DRAFT_KEY, type HoursOverride } from '../lib/visit';
  import { initializeApp } from 'firebase/app';
  import { getAuth, connectAuthEmulator, onAuthStateChanged, signInWithEmailAndPassword, createUserWithEmailAndPassword, sendPasswordResetEmail, signOut, type User } from 'firebase/auth';
  import { getFirestore, connectFirestoreEmulator, doc, setDoc, serverTimestamp } from 'firebase/firestore/lite';

  const cfg = {
    apiKey: import.meta.env.PUBLIC_FB_API_KEY, authDomain: import.meta.env.PUBLIC_FB_AUTH_DOMAIN,
    projectId: import.meta.env.PUBLIC_FB_PROJECT_ID, appId: import.meta.env.PUBLIC_FB_APP_ID,
  };
  const connected = Boolean(cfg.apiKey && cfg.projectId);
  const app = connected ? initializeApp(cfg) : null;
  const auth = app ? getAuth(app) : null;
  const db = app ? getFirestore(app) : null;
  // Local testing only (never on the real site): add ?emulator to use the Firebase emulators.
  if (auth && db && /^(localhost|127\.0\.0\.1|.+\.test)$/.test(location.hostname) && new URLSearchParams(location.search).has('emulator')) {
    connectAuthEmulator(auth, 'http://127.0.0.1:9099', { disableWarnings: true });
    connectFirestoreEmulator(db, '127.0.0.1', 8080);
  }

  const root = document.getElementById('editor')!;
  const status = document.getElementById('status')!;
  const account = document.getElementById('account')!;
  const publishBtn = document.getElementById('publish') as HTMLButtonElement;
  const clone = (v: Category[]): Category[] => JSON.parse(JSON.stringify(v));
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  // What goes on the website: no blank rows, no empty categories.
  const tidy = (v: Category[]): Category[] => v
    .map((c) => ({ name: c.name.trim(), items: c.items.map((i) => ({ name: i.name.trim(), price: i.price.trim(), note: (i.note ?? '').trim() })).filter((i) => i.name) }))
    .filter((c) => c.name && c.items.length);

  let state: Category[] = clone(defaults);
  let live: Category[] = clone(defaults);
  const notice = document.getElementById('shop-notice') as HTMLTextAreaElement;
  const hoursEditor = document.getElementById('hours-editor')!;
  let liveVisit = parseVisit();
  let visit = parseVisit();
  let user: User | null = null;
  let ready = false;
  let publishing = false;
  const canPublish = () => Boolean(user) && ready && !publishing;

  const refresh = () => {
    publishBtn.disabled = !canPublish();
    publishBtn.title = user ? '' : 'Sign in first';
  };

  const saveDraft = () => {
    try {
      localStorage.setItem(STORE_KEY, JSON.stringify(state));
      localStorage.setItem(VISIT_DRAFT_KEY, JSON.stringify(visit));
      status.textContent = 'Draft saved on this device. Not published yet.';
    } catch {
      status.textContent = 'Could not save the draft on this device';
    }
  };

  const drawHours = () => {
    notice.value = visit.notice;
    hoursEditor.innerHTML = visit.overrides.map((entry, index) => `
      <fieldset class="special-row" data-hour-index="${index}">
        <legend>Special date ${index + 1}</legend>
        <label>Date<input type="date" data-hour-field="date" value="${esc(entry.date)}" /></label>
        <label>Opens<input type="time" data-hour-field="open" value="${esc(entry.open)}" ${entry.closed ? 'disabled' : ''} /></label>
        <label>Closes<input type="time" data-hour-field="close" value="${esc(entry.close)}" ${entry.closed ? 'disabled' : ''} /></label>
        <label class="closed-toggle"><input type="checkbox" data-hour-field="closed" ${entry.closed ? 'checked' : ''} /> Closed all day</label>
        <button type="button" class="danger" data-remove-hours>Remove<span class="sr"> date ${index + 1}</span></button>
      </fieldset>`).join('');
  };
  notice.addEventListener('input', () => { visit.notice = notice.value; saveDraft(); });
  document.getElementById('add-hours')!.addEventListener('click', () => {
    visit.overrides.push({ date: '', open: '09:00', close: '20:00', closed: false });
    drawHours();
    saveDraft();
    hoursEditor.querySelector<HTMLInputElement>('.special-row:last-child input')?.focus();
  });
  hoursEditor.addEventListener('input', (event) => {
    const input = event.target as HTMLInputElement;
    const row = input.closest<HTMLElement>('[data-hour-index]')!;
    const entry = visit.overrides[Number(row.dataset.hourIndex)];
    const field = input.dataset.hourField as keyof HoursOverride;
    if (field === 'closed') {
      entry.closed = input.checked;
      row.querySelectorAll<HTMLInputElement>('input[type=time]').forEach((time) => { time.disabled = entry.closed; });
    } else entry[field] = input.value;
    saveDraft();
  });
  hoursEditor.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest('[data-remove-hours]');
    if (!button) return;
    const row = button.closest<HTMLElement>('[data-hour-index]')!;
    visit.overrides.splice(Number(row.dataset.hourIndex), 1);
    drawHours();
    saveDraft();
    document.getElementById('add-hours')?.focus();
  });

  const render = () => {
    root.innerHTML = state.map((c, ci) => `
      <section class="cat" data-c="${ci}">
        <div class="cat__head">
          <input class="cat__name" data-f="cname" aria-label="Category name" placeholder="Category name" value="${esc(c.name)}" />
          <div class="tools">
            <button type="button" data-a="cup" aria-label="Move category up" ${ci === 0 ? 'disabled' : ''}>↑</button>
            <button type="button" data-a="cdown" aria-label="Move category down" ${ci === state.length - 1 ? 'disabled' : ''}>↓</button>
            <button type="button" data-a="cdel" class="danger">Delete category</button>
          </div>
        </div>
        <div class="heads" aria-hidden="true"><span>Service</span><span>Price</span><span>Note (optional)</span><span></span></div>
        ${c.items.map((it, ii) => `
          <div class="item" data-i="${ii}">
            <input data-f="name" aria-label="Service name" placeholder="Service name" value="${esc(it.name)}" />
            <input data-f="price" aria-label="Price" placeholder="£0" inputmode="decimal" value="${esc(it.price)}" />
            <input data-f="note" aria-label="Note" placeholder="Short note" value="${esc(it.note)}" />
            <div class="tools">
              <button type="button" data-a="up" aria-label="Move service up" ${ii === 0 ? 'disabled' : ''}>↑</button>
              <button type="button" data-a="down" aria-label="Move service down" ${ii === c.items.length - 1 ? 'disabled' : ''}>↓</button>
              <button type="button" data-a="del" class="danger" aria-label="Delete ${esc(it.name) || 'service'}">✕</button>
            </div>
          </div>`).join('')}
        <button type="button" class="add" data-a="add">+ Add a service</button>
      </section>`).join('') + `<button type="button" class="add add--cat" data-a="cadd">+ Add a category</button>`;
  };

  const where = (el: Element) => {
    const c = el.closest<HTMLElement>('[data-c]');
    const i = el.closest<HTMLElement>('[data-i]');
    return { ci: c ? Number(c.dataset.c) : -1, ii: i ? Number(i.dataset.i) : -1 };
  };
  const swap = <T,>(a: T[], x: number, y: number) => { [a[x], a[y]] = [a[y], a[x]]; };

  root.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    const { ci, ii } = where(t);
    if (t.dataset.f === 'cname') state[ci].name = t.value;
    else if (ii > -1) (state[ci].items[ii] as Record<string, string>)[t.dataset.f!] = t.value;
    saveDraft();
  });

  // A bare number in the price box becomes pounds: 15 -> £15
  root.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.dataset.f !== 'price') return;
    const v = t.value.trim();
    if (/^\d+([.,]\d{1,2})?$/.test(v)) {
      const { ci, ii } = where(t);
      t.value = state[ci].items[ii].price = `£${v.replace(',', '.')}`;
      saveDraft();
    }
  });

  root.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-a]');
    if (!b) return;
    const { ci, ii } = where(b);
    const a = b.dataset.a;
    if (a === 'cadd') state.push({ name: 'New category', items: [{ name: '', price: '', note: '' }] });
    else if (a === 'add') state[ci].items.push({ name: '', price: '', note: '' });
    else if (a === 'del') { if (!confirm(`Delete "${state[ci].items[ii].name || 'this service'}"?`)) return; state[ci].items.splice(ii, 1); }
    else if (a === 'cdel') { if (!confirm(`Delete the category "${state[ci].name}" and its ${state[ci].items.length} services?`)) return; state.splice(ci, 1); }
    else if (a === 'up') swap(state[ci].items, ii, ii - 1);
    else if (a === 'down') swap(state[ci].items, ii, ii + 1);
    else if (a === 'cup') swap(state, ci, ci - 1);
    else if (a === 'cdown') swap(state, ci, ci + 1);
    render();
    saveDraft();
    if (a === 'add') root.querySelector<HTMLInputElement>(`[data-c="${ci}"] .item:last-of-type input`)?.focus();
    if (a === 'cadd') { const el = root.querySelector<HTMLInputElement>('.cat:last-of-type .cat__name'); el?.focus(); el?.select(); }
  });

  document.getElementById('reset')!.addEventListener('click', () => {
    if (!confirm('Discard unpublished changes to prices, special hours and the shop notice on this device?')) return;
    try { localStorage.removeItem(STORE_KEY); localStorage.removeItem(VISIT_DRAFT_KEY); } catch { /* nothing stored */ }
    state = clone(live);
    visit = structuredClone(liveVisit);
    render();
    drawHours();
    status.textContent = 'Drafts discarded. Showing the published prices and shop updates.';
  });

  document.getElementById('export')!.addEventListener('click', () => {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([JSON.stringify(tidy(state), null, 2)], { type: 'application/json' }));
    a.download = 'hampton-barbers-prices.json';
    a.click();
    URL.revokeObjectURL(a.href);
  });

  // ---------- Publishing ----------
  publishBtn.addEventListener('click', async () => {
    if (!db || !user || !canPublish()) return;
    const publisher = user;
    const out = tidy(state);
    if (!out.length) { status.textContent = 'Add at least one service before publishing.'; return; }
    const nextVisit = structuredClone(visit);
    nextVisit.notice = nextVisit.notice.trim();
    if (!nextVisit.overrides.every(validOverride)) {
      status.textContent = 'Enter a date and valid opening hours for each row, or mark it closed.';
      return;
    }
    if (new Set(nextVisit.overrides.map(({ date }) => date)).size !== nextVisit.overrides.length) {
      status.textContent = 'Use one entry per special date.';
      return;
    }
    publishing = true;
    refresh();
    const locked = [root, notice.closest<HTMLElement>('section')!, document.querySelector<HTMLElement>('.adm__foot')!];
    locked.forEach((element) => { element.inert = true; });
    status.textContent = 'Publishing…';
    const write = () => setDoc(doc(db, 'site', 'menu'), { json: JSON.stringify(out), ...(nextVisit.notice || nextVisit.overrides.length ? { visit: JSON.stringify(nextVisit) } : {}), updatedAt: serverTimestamp() });
    const denied = (err: unknown) => String((err as { code?: string }).code ?? '').includes('permission');
    try {
      try {
        await write();
      } catch (err) {
        if (!denied(err)) throw err;
        // Nobody owns the price list yet: claim it for this account, then publish.
        await setDoc(doc(db, 'site', 'owner'), { uid: publisher.uid });
        await write();
      }
      try { localStorage.removeItem(STORE_KEY); localStorage.removeItem(VISIT_DRAFT_KEY); } catch { /* nothing stored */ }
      live = clone(out); state = clone(out);
      liveVisit = structuredClone(nextVisit); visit = structuredClone(nextVisit);
      render();
      drawHours();
      status.textContent = 'Published prices and shop updates.';
    } catch (err) {
      status.textContent = denied(err)
        ? 'This account is not allowed to change the prices. Sign in with the account that set this up.'
        : 'Publishing failed. Check your internet connection and try again.';
    }
    publishing = false;
    locked.forEach((element) => { element.inert = false; });
    refresh();
  });

  // ---------- Account ----------
  const authMessage = (err: unknown) => {
    const code = (err as { code?: string }).code ?? '';
    if (/invalid-credential|wrong-password|user-not-found/.test(code)) return 'The email or password is not right.';
    if (code.includes('email-already-in-use')) return 'That email already has an account. Sign in instead.';
    if (code.includes('weak-password')) return 'Choose a password with at least 6 characters.';
    if (code.includes('invalid-email')) return 'That does not look like an email address.';
    if (code.includes('too-many-requests')) return 'Too many tries. Wait a few minutes and try again.';
    if (code.includes('operation-not-allowed')) return 'Email sign-in is not switched on in Firebase yet.';
    return 'That did not work. Check your internet connection and try again.';
  };

  const drawAccount = (msg = '') => {
    const note = msg ? `<p class="acct__msg" role="alert">${esc(msg)}</p>` : '';
    if (!connected) {
      account.innerHTML = '<p><strong>Not connected.</strong> This copy of the site has no Firebase settings, so drafts stay on this device and cannot be published.</p>';
    } else if (!user) {
      account.innerHTML = `
        <form id="signin" novalidate>
          <h2>Sign in to publish</h2>
          <p class="acct__hint">First time? Type your email, choose a password, and press Create my account. No confirmation email is needed.</p>
          <div class="acct__row">
            <label>Email<input type="email" name="email" autocomplete="username" required /></label>
            <label>Password<input type="password" name="password" autocomplete="current-password" required minlength="6" /></label>
          </div>
          <div class="acct__btns">
            <button type="submit" class="primary">Sign in</button>
            <button type="button" data-acct="create">Create my account</button>
            <button type="button" data-acct="forgot" class="link">Forgot password</button>
          </div>
          ${note}
        </form>`;
    } else {
      account.innerHTML = `<p>Signed in as <strong>${esc(user.email)}</strong>. <button type="button" data-acct="out" class="link">Sign out</button></p>${note}`;
    }
    refresh();
  };

  const creds = () => {
    const f = document.getElementById('signin') as HTMLFormElement | null;
    const d = f ? new FormData(f) : null;
    return { email: String(d?.get('email') ?? '').trim(), password: String(d?.get('password') ?? '') };
  };

  account.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!auth) return;
    const { email, password } = creds();
    if (!email || !password) return drawAccount('Enter your email and password.');
    try { await signInWithEmailAndPassword(auth, email, password); } catch (err) { drawAccount(authMessage(err)); }
  });

  account.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-acct]');
    if (!b || !auth) return;
    const act = b.dataset.acct;
    try {
      if (act === 'create') {
        const { email, password } = creds();
        if (!email || password.length < 6) return drawAccount('Enter your email and a password of at least 6 characters, then press Create my account.');
        await createUserWithEmailAndPassword(auth, email, password);
      } else if (act === 'forgot') {
        const { email } = creds();
        if (!email) return drawAccount('Type your email first, then press Forgot password.');
        await sendPasswordResetEmail(auth, email);
        drawAccount('If that email has an account, a reset link is on its way.');
      } else if (act === 'out') {
        await signOut(auth);
      }
    } catch (err) { drawAccount(authMessage(err)); }
  });

  if (auth) onAuthStateChanged(auth, (u) => { user = u; drawAccount(); });
  else drawAccount();

  // ---------- Start: draft first, otherwise what is on the website now ----------
  (async () => {
    const fetched = await fetchLive();
    if (fetched?.menu.length) live = fetched.menu;
    if (fetched) liveVisit = fetched.visit;
    let draft: Category[] | null = null;
    let visitDraft: string | null = null;
    try { const s = localStorage.getItem(STORE_KEY); if (s) draft = JSON.parse(s); visitDraft = localStorage.getItem(VISIT_DRAFT_KEY); } catch { /* ignore a broken draft */ }
    state = clone(draft ?? live);
    visit = structuredClone(liveVisit);
    if (visitDraft) {
      try {
        const saved = JSON.parse(visitDraft);
        if (Array.isArray(saved?.overrides) && typeof saved.notice === 'string') visit = saved;
      } catch { /* ignore a broken draft */ }
    }
    render();
    drawHours();
    notice.closest('section')!.inert = false;
    ready = true;
    refresh();
    status.textContent = draft || visitDraft ? 'You have an unpublished draft on this device.' : fetched ? 'Showing the published prices.' : 'Showing the built-in prices. Nothing has been published yet.';
  })();
</script>

<style is:global>
  .adm { --bg: #f4f2ee; --text: #15140f; --accent: #15140f; --on-accent: #fff; --line: #d9d4c8; background: #f4f2ee; color: #15140f; min-height: 100svh; padding: clamp(1.25rem, 4vw, 3rem) clamp(1rem, 4vw, 3rem) 4rem; }
  .adm > * { max-width: 62rem; margin-inline: auto; }
  .adm__top { display: flex; justify-content: space-between; align-items: end; gap: 1rem; flex-wrap: wrap; position: sticky; top: 0; z-index: 5; background: #f4f2ee; padding-block: .75rem; border-bottom: 1px solid var(--line); }
  .adm__back { font-size: .9rem; color: #57534a; }
  .adm h1 { font-family: 'Bricolage Grotesque Variable', system-ui, sans-serif; font-weight: 800; font-size: clamp(1.8rem, 5vw, 2.8rem); letter-spacing: -.04em; margin-top: .35rem; }
  .adm h2 { font-family: 'Bricolage Grotesque Variable', system-ui, sans-serif; font-weight: 700; font-size: 1.25rem; letter-spacing: -.02em; margin-bottom: .75rem; }
  .adm__pub { display: grid; justify-items: end; gap: .4rem; }
  #status { font-size: .9rem; font-weight: 600; color: #2a7a4b; text-align: right; }
  .adm__note { background: #fff7d6; border: 1px solid #e6d68a; border-radius: 10px; padding: .9rem 1.1rem; font-size: .95rem; margin-block: 1.25rem; }
  .adm textarea { width: 100%; font: inherit; padding: .75rem; border: 1px solid var(--line); border-radius: 8px; }
  .visit-help { margin-bottom: .9rem; }
  .special-row { display: flex; flex-wrap: wrap; gap: .7rem; align-items: end; border: 1px solid var(--line); margin: .7rem 0; }
  .special-row label { display: grid; flex: 1 1 8rem; }
  .special-row .closed-toggle { display: flex; align-items: center; gap: .35rem; }
  .special-row input[type=checkbox] { width: 1rem; min-height: 1rem; }
  .adm input, .adm button { font: inherit; }
  .adm input { width: 100%; min-height: 2.75rem; padding: .5rem .75rem; border: 1px solid var(--line); border-radius: 8px; background: #fff; color: inherit; }
  .adm input:focus-visible { outline: 3px solid #2f6fed; outline-offset: 1px; border-color: #2f6fed; }
  .adm button { min-height: 2.75rem; padding: .4rem .85rem; border: 1px solid var(--line); border-radius: 8px; background: #fff; color: inherit; cursor: pointer; font-weight: 600; }
  .adm button:hover:not(:disabled) { border-color: #15140f; }
  .adm button:disabled { opacity: .35; cursor: default; }
  .adm .primary { background: #15140f; color: #fff; border-color: #15140f; padding-inline: 1.2rem; }
  .adm .primary:disabled { opacity: .4; }
  .adm .link { border: 0; background: none; text-decoration: underline; padding-inline: .25rem; min-height: 2.75rem; }
  .adm .danger { color: #b3261e; }
  .adm .danger:hover:not(:disabled) { border-color: #b3261e; background: #fdecea; }
  .acct { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 1.1rem; margin-top: 1.25rem; }
  .acct__row { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
  .acct label { display: grid; gap: .3rem; font-size: .85rem; font-weight: 600; }
  .acct__btns { display: flex; gap: .5rem; flex-wrap: wrap; margin-top: .85rem; align-items: center; }
  .acct__hint { font-size: .92rem; color: #57534a; margin-bottom: .75rem; }
  .acct__msg { margin-top: .75rem; color: #8a4b00; font-weight: 600; font-size: .95rem; }
  .cat { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 1.1rem; margin-bottom: 1.25rem; }
  .cat__head { display: flex; gap: .75rem; align-items: center; margin-bottom: 1rem; }
  .cat__name { font-family: 'Bricolage Grotesque Variable', system-ui, sans-serif; font-weight: 700; font-size: 1.35rem !important; letter-spacing: -.02em; }
  .tools { display: flex; gap: .35rem; flex: none; }
  .heads, .item { display: grid; grid-template-columns: 1.4fr 6rem 1.8fr auto; gap: .5rem; align-items: center; }
  .heads { font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #8a8477; padding-inline: .15rem; margin-bottom: .35rem; }
  .heads span:last-child { width: 9.1rem; }
  .item { margin-bottom: .5rem; }
  .add { margin-top: .5rem; border-style: dashed !important; }
  .add--cat { display: block; width: 100%; max-width: 62rem; min-height: 3.5rem !important; background: transparent !important; }
