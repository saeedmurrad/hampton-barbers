---
// The barber panel: each barber's own screen, made for a phone. Your chair, who is next,
// call and finish with one tap, breaks and shifts, and your cuts today.
import '../styles/staff.css';
import Base from '../layouts/Base.astro';
import { shops, menu } from '../data/site';
import { penceOf } from '../lib/sales';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const services = menu.flatMap((c) => c.items.map((i) => ({ name: i.name, price: penceOf(i.price) })));
---
<Base noindex title="Hampton Barbers: barber panel" description="Each barber’s own screen: your chair, who is next, and your cuts today." themeColor="#f4f2ee">
  <main id="main" class="bp" data-base={base} data-shops={JSON.stringify(shops.map((s) => ({ id: s.id, name: s.name })))} data-services={JSON.stringify(services)}>
    <header class="bp__top">
      <div class="bp__who" data-who><b>Barber panel</b></div>
      <p id="bp-status" role="status" aria-live="polite">Loading…</p>
    </header>

    <section class="bp__card bp__setup" data-setup hidden></section>

    <section class="bp__card bp__chair" data-chair aria-live="polite" hidden></section>

    <section class="bp__card" data-waiting hidden>
      <div class="bp__head"><h2>Waiting</h2><p data-summary></p></div>
      <ol class="bp__line" data-queue></ol>
      <form class="bp__add" data-add>
        <input name="name" maxlength="24" autocomplete="off" placeholder="First name (optional)" aria-label="Walk-in’s first name (optional)" />
        <button type="submit">+ Add walk-in</button>
      </form>
    </section>

    <section class="bp__card bp__acct" id="bp-account" aria-label="Your account"></section>
    <p class="bp__links"><a href={`${base}/admin/live/`}>Queue desk</a></p>
  </main>
</Base>

<script>
  import { addWalkIn, barberLabel, boardView, callNext, clockText, minsText, removeTicket, setBarber, uncall } from '../lib/board';
  import { createDesk } from '../lib/desk';
  import { finishAndPay, loadServices, type Service } from '../lib/paysheet';
  import { BARBER_KEY, esc, newId, read, write } from '../lib/store';

  const root = document.querySelector<HTMLElement>('.bp')!;
  const shops = JSON.parse(root.dataset.shops!) as { id: string; name: string }[];
  let services = JSON.parse(root.dataset.services || '[]') as Service[];
  loadServices(services).then((list) => { services = list; });
  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const statusEl = $('#bp-status'), whoEl = $('[data-who]'), setupEl = $('[data-setup]'), chairEl = $('[data-chair]');
  const waitingEl = $('[data-waiting]'), queueEl = $('[data-queue]'), summaryEl = $('[data-summary]'), account = $('#bp-account');
  const fill = (el: HTMLElement, html: string) => { if (el.dataset.html !== html) { el.innerHTML = html; el.dataset.html = html; } };
  const shopName = (id: string) => shops.find((s) => s.id === id)?.name ?? 'the shop';

  // Which shop and barber this phone belongs to. Remembered, so the panel opens ready to use.
  type Me = { shop: string; id: string };
  let me: Me = read<Me>(BARBER_KEY) ?? { shop: shops[0].id, id: '' };
  const asked = shops.find((s) => s.id === new URLSearchParams(location.search).get('shop'))?.id;
  if (asked && asked !== me.shop) me = { shop: asked, id: '' };
  if (!shops.some((s) => s.id === me.shop)) me = { shop: shops[0].id, id: '' };
  const setMe = (m: Me) => { me = m; write(BARBER_KEY, m); draw(); };
  let accountMsg = '';
  let drawnFor: string | null | undefined;

  const toast = (msg: string, action?: { label: string; run: () => void }) => {
    document.querySelector('.staff-toast')?.remove();
    const t = Object.assign(document.createElement('p'), { className: 'staff-toast' });
    t.setAttribute('role', 'status');
    t.append(msg);
    if (action) {
      const b = Object.assign(document.createElement('button'), { type: 'button', textContent: action.label });
      b.addEventListener('click', () => { t.remove(); action.run(); });
      t.append(b);
    }
    document.body.append(t);
    setTimeout(() => t.remove(), action ? 12_000 : 4500);
  };

  const desk = createDesk(shops.map((s) => s.id), () => draw());

  const drawAccount = () => {
    const email = desk.email();
    if (drawnFor === email && !accountMsg) return;
    drawnFor = email;
    const note = accountMsg ? `<p class="bp__msg" role="alert">${esc(accountMsg)}</p>` : '';
    accountMsg = '';
    if (!desk.connected) { account.innerHTML = '<p><strong>Not connected.</strong> Changes show on this device only.</p>'; return; }
    account.innerHTML = email
      ? `<p>Signed in as <strong>${esc(email)}</strong>. <button type="button" class="link" data-out>Sign out</button></p>${note}`
      : `<form id="bp-signin" class="bp__signin"><b>Sign in to run the real queue</b>
          <input type="email" name="email" autocomplete="username" placeholder="Email" required />
          <input type="password" name="password" autocomplete="current-password" placeholder="Password" required />
          <button type="submit" class="primary">Sign in</button></form>${note}
        <p class="bp__hint">Until you sign in this is a demo that stays on this device.</p>`;
  };

  const draw = () => {
    const now = Date.now();
    const b = desk.board(me.shop, now);
    const v = boardView(b, now);
    const s = b.staff[me.id];
    statusEl.textContent = desk.offline(me.shop) ? 'No connection. Showing the last known queue.' : desk.status();
    drawAccount();
    setupEl.hidden = Boolean(s);
    chairEl.hidden = waitingEl.hidden = !s;

    if (!s) {
      fill(whoEl, '<b>Barber panel</b>');
      const staff = Object.entries(b.staff).sort((x, y) => x[1].chair - y[1].chair);
      fill(setupEl, `<h2>Which shop are you at?</h2>
        <div class="bp__pick">${shops.map((x) => `<button type="button" data-shop="${x.id}" aria-pressed="${x.id === me.shop}">${esc(x.name)}</button>`).join('')}</div>
        <h2>Who are you?</h2>
        <div class="bp__pick">${staff.map(([id, x]) => `<button type="button" data-me="${id}"><b>${esc(barberLabel(x))}</b><small>Chair ${x.chair}</small></button>`).join('') || '<p class="bp__hint">No barbers have been added for this shop yet. Add them on the queue desk.</p>'}</div>
        <p class="bp__hint">This phone remembers your choice. Barbers and their names are managed on the queue desk.</p>`);
      return;
    }

    fill(whoEl, `<b>${esc(barberLabel(s))}</b><span>Chair ${s.chair} · ${esc(shopName(me.shop))}</span><button type="button" class="link" data-switch>Change</button>`);
    const mine = v.chairs.find((c) => c.id === me.id);
    const next = v.line.find((x) => x.s === 'here');
    let html: string;
    if (!s.on) {
      html = `<p class="bp__state">You’re off shift</p><p class="bp__sub">Customers are not sent to your chair.</p>
        <div class="bp__btns"><button type="button" class="primary big" data-shift="on">Start my shift</button></div>`;
    } else if (mine?.state === 'busy') {
      const nm = desk.name(me.shop, mine.tid!);
      html = `<p class="bp__label">In your chair</p><p class="bp__num">${mine.n}</p>
        <p class="bp__sub">${nm ? `${esc(nm)} · ` : ''}${mine.calling ? 'called just now' : `${mine.mins} min so far`}</p>
        <div class="bp__btns"><button type="button" class="primary big" data-finish>Finish and take payment</button><button type="button" data-noshow="${mine.tid}">Didn’t come</button><button type="button" data-uncall="${mine.tid}">Undo call</button></div>`;
    } else if (s.brk) {
      html = `<p class="bp__state">On a break</p><p class="bp__sub">Customers are not sent to your chair.</p>
        <div class="bp__btns"><button type="button" class="primary big" data-brk="off">Back from my break</button></div>`;
    } else if (next) {
      const nm = desk.name(me.shop, next.id);
      html = `<p class="bp__label">Next for you</p><p class="bp__num">${next.n}</p>
        <p class="bp__sub">${nm ? `${esc(nm)} · ` : ''}in the shop</p>
        <div class="bp__btns"><button type="button" class="primary big" data-call>Call number ${next.n}</button><button type="button" data-brk="on">Take a break</button><button type="button" data-shift="off">End my shift</button></div>`;
    } else {
      html = `<p class="bp__state">Your chair is free</p><p class="bp__sub">${v.onWay ? `${v.onWay} on the way, nobody in the shop yet.` : 'Nobody is waiting.'}</p>
        <div class="bp__btns"><button type="button" data-brk="on">Take a break</button><button type="button" data-shift="off">End my shift</button></div>`;
    }
    fill(chairEl, `${html}<p class="bp__today">Your cuts today: <b>${s.done}</b></p>`);

    const free = s.on && !s.brk && mine?.state === 'free';
    summaryEl.textContent = `${v.inShop} in the shop · ${v.onWay} on the way`;
    fill(queueEl, v.line.map((x) => {
      const k = b.t[x.id];
      const nm = desk.name(me.shop, x.id);
      const title = nm ? esc(nm) : k.src === 'desk' ? 'Walk-in' : 'Online customer';
      const sub = x.s === 'here' ? 'In the shop' : `On the way · due ${clockText(x.due)}`;
      return `<li class="${x.s}"><span class="n">${x.n}</span><span class="who"><b>${title}</b><small>${sub}</small></span><span class="eta">${minsText(x.mins)}</span>${free ? `<button type="button" data-call-id="${x.id}" aria-label="Call number ${x.n} to my chair">Call</button>` : ''}</li>`;
    }).join('') || '<li class="empty">Nobody waiting</li>');
  };

  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('button');
    if (!t) return;
    const d = t.dataset;
    const shop = me.shop, id = me.id;
    if (d.shop) setMe({ shop: d.shop, id: '' });
    else if (d.me) setMe({ shop, id: d.me });
    else if ('switch' in d) setMe({ shop, id: '' });
    else if ('call' in d) desk.act(shop, (b, now) => callNext(b, id, now));
    else if (d.callId) desk.act(shop, (b, now) => callNext(b, id, now, d.callId));
    else if ('finish' in d) finishAndPay(desk, shop, id, services, toast);
    else if (d.uncall) desk.act(shop, (b, now) => uncall(b, d.uncall!, now));
    else if (d.noshow) { if (confirm('Remove this customer from the queue because they didn’t come?')) desk.act(shop, (b, now) => removeTicket(b, d.noshow!, now)); }
    else if (d.brk) desk.act(shop, (b, now) => setBarber(b, id, { brk: d.brk === 'on' }, now));
    else if (d.shift) desk.act(shop, (b, now) => setBarber(b, id, { on: d.shift === 'on' }, now));
    else if ('out' in d) desk.signOut();
  });
  $<HTMLFormElement>('[data-add]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = (e.target as HTMLFormElement).querySelector<HTMLInputElement>('input')!;
    const name = input.value.trim().replace(/\s+/g, ' ').slice(0, 24);
    const shop = me.shop, id = newId('w');
    input.value = '';
    if (!(await desk.act(shop, (b, now) => addWalkIn(b, id, now)))) { input.value ||= name; return; }
    if (name) desk.setName(shop, id, name);
    toast(`Number ${desk.board(shop).t[id]?.n ?? ''}${name ? ` for ${name}` : ''}: added to the queue`);
  });
  account.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(e.target as HTMLFormElement);
    try { await desk.signIn(String(f.get('email')).trim(), String(f.get('password'))); }
    catch { accountMsg = 'The email or password is not right.'; draw(); }
  });

  draw();
  setInterval(draw, 15_000);
</script>

<style is:global>
  .bp { --bg: #f4f2ee; --text: #15140f; --muted: #57534a; --accent: #15140f; --on-accent: #fff; --line: #d9d4c8; --ok: #1f8a4c; --warn: #b4690e; --display: 'Bricolage Grotesque Variable', system-ui, sans-serif; background: #f4f2ee; color: #15140f; min-height: 100svh; padding: 0 clamp(.9rem, 4vw, 2rem) 4rem; display: grid; gap: .9rem; align-content: start; }
  .bp > * { width: min(100%, 34rem); margin-inline: auto; }
  .bp__top { position: sticky; top: 0; z-index: 5; background: #f4f2ee; padding-block: .9rem .6rem; border-bottom: 1px solid var(--line); display: grid; gap: .3rem; }
  .bp__who { display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .7rem; }
  .bp__who b { font-family: var(--display); font-weight: 800; font-size: 1.7rem; letter-spacing: -.03em; line-height: 1.1; }
  .bp__who span { color: var(--muted); font-size: .92rem; }
  #bp-status { font-weight: 700; font-size: .85rem; color: var(--ok); }
  .bp h2 { font-family: var(--display); font-weight: 750; font-size: 1.25rem; letter-spacing: -.02em; }
  .bp button, .bp input { font: inherit; }
  .bp button { min-height: 3rem; padding: .55rem 1rem; border: 1px solid var(--line); border-radius: 12px; background: #fff; color: inherit; font-weight: 650; cursor: pointer; }
  .bp button:hover { border-color: #15140f; }
  .bp .primary { background: #15140f; color: #fff; border-color: #15140f; }
  .bp .big { min-height: 4.2rem; font-size: 1.25rem; flex: 1 1 100%; border-radius: 16px; }
  .bp .link { border: 0; background: none; text-decoration: underline; min-height: auto; padding: 0 .1rem; font-size: .9rem; }
  .bp input { min-height: 3rem; padding: .5rem .75rem; border: 1px solid var(--line); border-radius: 12px; background: #fff; min-width: 0; }
  .bp__card { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 1.1rem 1.15rem 1.2rem; }
  .bp__card[hidden] { display: none; }
  .bp__setup { display: grid; gap: .7rem; }
  .bp__pick { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr)); gap: .5rem; margin-bottom: .5rem; }
  .bp__pick button { display: grid; gap: .1rem; text-align: left; min-height: 3.6rem; }
  .bp__pick button small { color: var(--muted); font-weight: 500; font-size: .82rem; }
  .bp__pick button[aria-pressed='true'] { background: #15140f; color: #fff; border-color: #15140f; }
  .bp__chair { text-align: center; }
  .bp__label { font-size: .78rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .bp__num { font-family: var(--display); font-weight: 800; font-size: clamp(5rem, 28vw, 8rem); line-height: .95; letter-spacing: -.04em; }
  .bp__state { font-family: var(--display); font-weight: 800; font-size: 2rem; letter-spacing: -.03em; line-height: 1.1; padding-top: .6rem; }
  .bp__sub { color: var(--muted); margin-top: .2rem; }
  .bp__btns { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.1rem; }
  .bp__btns button { flex: 1 1 8rem; }
  .bp__today { margin-top: 1rem; padding-top: .8rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .92rem; }
  .bp__today b { color: #15140f; font-size: 1.1rem; }
  .bp__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .2rem 1rem; margin-bottom: .8rem; }
  .bp__head p { font-size: .85rem; color: var(--muted); }
  .bp__line { display: grid; gap: .45rem; }
  .bp__line li { display: grid; grid-template-columns: 2.8rem minmax(0, 1fr) auto auto; align-items: center; gap: .3rem .7rem; padding: .55rem .7rem; border-radius: 12px; background: #f7f4ee; }
  .bp__line li.way { background: #fff7e8; box-shadow: 0 0 0 1.5px #ecc46f inset; }
  .bp__line .n { font-family: var(--display); font-weight: 800; font-size: 1.6rem; line-height: 1; text-align: center; letter-spacing: -.03em; }
  .bp__line .who { display: grid; min-width: 0; }
  .bp__line .who small { color: var(--muted); font-size: .8rem; }
  .bp__line li.way .who small { color: var(--warn); font-weight: 600; }
  .bp__line .eta { font-weight: 750; font-size: .88rem; white-space: nowrap; }
  .bp__line button { min-height: 2.5rem; padding: .3rem .8rem; font-size: .88rem; }
  .bp__line .empty { display: block; background: none; color: var(--muted); padding: .3rem .1rem; }
  .bp__add { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .9rem; }
  .bp__add input { flex: 1 1 9rem; }
  .bp__signin { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
  .bp__signin b { width: 100%; }
  .bp__signin input { flex: 1 1 10rem; }
  .bp__hint { font-size: .85rem; color: var(--muted); }
  .bp__msg { color: #8a4b00; font-weight: 600; margin-top: .5rem; }
  .bp__links { font-size: .9rem; text-align: center; color: var(--muted); }
</style>
