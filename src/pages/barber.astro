---
// The barber panel: each barber's own screen, made for a phone. Your chair, who is next,
// call and finish with one tap, breaks and shifts, and your own cuts and takings today.
import '../styles/ui.css';
import '../styles/staff.css';
import Base from '../layouts/Base.astro';
import { shops, menu } from '../data/site';
import { penceOf } from '../lib/sales';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const services = menu.flatMap((c) => c.items.map((i) => ({ name: i.name, price: penceOf(i.price) })));
---
<Base noindex title="Hampton Barbers: barber panel" description="Each barber’s own screen: your chair, who is next, and your cuts today." themeColor="#0a0c0b">
  <main id="main" class="ui" data-barber-app data-base={base} data-shops={JSON.stringify(shops.map((s) => ({ id: s.id, name: s.name })))} data-services={JSON.stringify(services)}>
    <div class="u-phone">
      <h1 class="sr">Barber panel</h1>
      <header class="u-me" data-who><span class="u-avatar u-avatar--lg">HB</span><span><b>Barber panel</b><small>Hampton Barbers</small></span></header>
      <p class="u-status" id="bp-status" role="status" aria-live="polite">Loading…</p>

      <section class="u-panel u-stack" data-setup hidden></section>
      <section class="u-hero" data-chair aria-live="polite" hidden></section>
      <section class="u-today" data-today aria-label="Your day so far" hidden></section>

      <section class="u-panel" data-waiting hidden>
        <div class="u-h"><h2>Next up <em data-count>0</em></h2><span data-summary></span></div>
        <ol class="u-line" data-queue></ol>
        <form class="u-add" data-add style="margin-top:.8rem;max-width:none">
          <input name="name" maxlength="24" autocomplete="off" placeholder="Walk-in’s first name (optional)" aria-label="Walk-in’s first name (optional)" />
          <button type="submit" class="u-btn">Add walk-in</button>
        </form>
      </section>

      <section class="u-acct" id="bp-account" aria-label="Your account"></section>
      <p class="u-hint" style="text-align:center"><a class="u-link" href={`${base}/admin/live/`}>Open the queue desk</a><span data-switch-wrap hidden> · <button type="button" class="u-link" data-switch>Switch barber</button></span></p>
      <footer class="u-dock" data-dock hidden></footer>
    </div>
  </main>
</Base>

<script>
  import { addWalkIn, barberLabel, boardView, callNext, clockText, cutMinutes, minsText, removeTicket, setBarber, uncall } from '../lib/board';
  import { createDesk } from '../lib/desk';
  import { finishAndPay, loadServices, type Service } from '../lib/paysheet';
  import { signInHtml, wireSignIn } from '../lib/signin';
  import { money, type Sale } from '../lib/sales';
  import { changePassword } from '../lib/cloud';
  import { BARBER_KEY, esc, newId, read, write } from '../lib/store';

  const root = document.querySelector<HTMLElement>('[data-barber-app]')!;
  const shops = JSON.parse(root.dataset.shops!) as { id: string; name: string }[];
  let services = JSON.parse(root.dataset.services || '[]') as Service[];
  loadServices(services).then((list) => { services = list; });
  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const statusEl = $('#bp-status'), whoEl = $('[data-who]'), setupEl = $('[data-setup]'), chairEl = $('[data-chair]'), todayEl = $('[data-today]'), dockEl = $('[data-dock]');
  const waitingEl = $('[data-waiting]'), queueEl = $('[data-queue]'), summaryEl = $('[data-summary]'), account = $('#bp-account');
  const fill = (el: HTMLElement, html: string) => { if (el.dataset.html !== html) { el.innerHTML = html; el.dataset.html = html; } };
  const shopName = (id: string) => shops.find((s) => s.id === id)?.name ?? 'the shop';
  const plainHead = '<span class="u-avatar u-avatar--lg">HB</span><span><b>Barber panel</b><small>Hampton Barbers</small></span>';

  // Which shop and barber this phone belongs to. Remembered, so the panel opens ready to use.
  type Me = { shop: string; id: string };
  let me: Me = read<Me>(BARBER_KEY) ?? { shop: shops[0].id, id: '' };
  const asked = shops.find((s) => s.id === new URLSearchParams(location.search).get('shop'))?.id;
  if (asked && asked !== me.shop) me = { shop: asked, id: '' };
  if (!shops.some((s) => s.id === me.shop)) me = { shop: shops[0].id, id: '' };
  const setMe = (m: Me) => { me = m; write(BARBER_KEY, m); draw(); };
  let accountMsg = '';
  let drawnFor: string | null | undefined;
  let pwOpen = false;
  // This barber's sales today, for "taken today". Reloaded after each finished cut.
  let takings: Sale[] | null = null;
  let takingsFor = '';
  const loadTakings = () => {
    const key = `${desk.email()}|${desk.role()}|${me.shop}|${me.id}`;
    takingsFor = key;
    if (!me.id) { takings = null; return; }
    desk.takings(me.shop, me.id).then((list) => { if (takingsFor === key) { takings = list; draw(); } });
  };

  const toast = (msg: string, action?: { label: string; run: () => void }) => {
    document.querySelector('.staff-toast')?.remove();
    const t = Object.assign(document.createElement('p'), { className: 'staff-toast' });
    t.setAttribute('role', 'status');
    t.append(msg);
    if (action) {
      const b = Object.assign(document.createElement('button'), { type: 'button', textContent: action.label });
      b.addEventListener('click', () => { t.remove(); action.run(); });
      t.append(b);
    }
    document.body.append(t);
    setTimeout(() => t.remove(), action ? 12_000 : 4500);
  };

  const desk = createDesk(shops.map((s) => s.id), () => draw());

  const drawAccount = () => {
    const email = desk.email();
    const state = `${email}|${pwOpen}`;
    if (drawnFor === state && !accountMsg) return;
    drawnFor = state;
    const note = accountMsg ? `<p class="u-msg" role="alert" style="margin-top:.6rem">${esc(accountMsg)}</p>` : '';
    accountMsg = '';
    account.classList.toggle('u-acct--line', Boolean(email));
    if (!desk.connected) { account.innerHTML = '<p><strong>Not connected.</strong> Changes show on this device only.</p>'; return; }
    account.innerHTML = email
      ? `<p style="text-align:center">Signed in as <strong>${esc(email)}</strong>. <button type="button" class="u-link" data-pw>Change password</button> · <button type="button" class="u-link" data-out>Sign out</button></p>${pwOpen ? '<form id="bp-pw" class="u-signin" style="margin-top:.7rem"><input class="u-input" type="text" name="pw" minlength="8" required autocomplete="off" placeholder="New password (8 or more characters)" aria-label="New password" /><button type="submit" class="u-btn u-btn--primary">Save password</button></form>' : ''}${note}`
      : `<details${note ? ' open' : ''}><summary>Sign in to run the real queue</summary>
          ${signInHtml({ formId: 'bp-signin' })}${note}
        <p class="u-hint" style="margin-top:.7rem">Until you sign in this is a demo that stays on this device.</p></details>`;
  };

  const draw = () => {
    const now = Date.now();
    // A barber's own login opens straight on their own profile.
    const linked = desk.role() === 'staff' && desk.me()?.b ? desk.me()! : null;
    if (linked && (me.shop !== linked.shop || me.id !== linked.b)) { me = { shop: linked.shop, id: linked.b }; write(BARBER_KEY, me); }
    const b = desk.board(me.shop, now);
    const v = boardView(b, now);
    const s = b.staff[me.id];
    statusEl.textContent = desk.offline(me.shop) ? 'No connection. Showing the last known queue.' : desk.status();
    drawAccount();
    if (takingsFor !== `${desk.email()}|${desk.role()}|${me.shop}|${me.id}`) loadTakings();
    const working = Boolean(s) && !desk.loading(me.shop) && desk.role() !== 'none';
    setupEl.hidden = working;
    chairEl.hidden = todayEl.hidden = waitingEl.hidden = dockEl.hidden = !working;
    // Only a shared phone can switch barber; a barber's own login always opens on their own profile.
    $('[data-switch-wrap]').hidden = !working || Boolean(linked);

    if (desk.loading(me.shop)) {
      fill(whoEl, plainHead);
      fill(setupEl, '<h2 class="u-pass__place">Loading the queue…</h2>');
      return;
    }
    if (desk.role() === 'none') {
      fill(whoEl, plainHead);
      fill(setupEl, '<h2 class="u-pass__place">This login has not been added yet</h2><p class="u-hint">Ask the owner to add this email under “Staff logins” on the queue desk. Then sign in here again.</p>');
      return;
    }
    if (!s) {
      fill(whoEl, plainHead);
      const staff = Object.entries(b.staff).sort((x, y) => x[1].chair - y[1].chair);
      fill(setupEl, `<div class="u-h" style="margin:0"><h2>Which shop are you at?</h2></div>
        <div class="u-links">${shops.map((x) => `<button type="button" class="u-btn${x.id === me.shop ? ' u-btn--primary' : ''}" data-shop="${x.id}" aria-pressed="${x.id === me.shop}">${esc(x.name)}</button>`).join('')}</div>
        <div class="u-h" style="margin:.4rem 0 0"><h2>Who are you?</h2></div>
        <div class="u-links">${staff.map(([id, x]) => `<button type="button" class="u-btn u-btn--lg" style="justify-content:flex-start;gap:.7rem" data-me="${id}"><span class="u-avatar u-avatar--sm">${esc(barberLabel(x)[0].toUpperCase())}</span><span style="display:grid;text-align:left;line-height:1.2"><b>${esc(barberLabel(x))}</b><small style="font-weight:500;color:var(--muted);font-size:.8rem">Chair ${x.chair}</small></span></button>`).join('') || '<p class="u-hint">No barbers have been added for this shop yet. Add them on the queue desk.</p>'}</div>
        <p class="u-hint">This phone remembers your choice. Barbers and their names are managed on the queue desk.</p>`);
      return;
    }

    const state = !s.on ? 'off' : s.brk ? 'break' : 'on';
    fill(whoEl, `<span class="u-avatar u-avatar--lg">${esc(barberLabel(s)[0].toUpperCase())}</span><span><b>${esc(barberLabel(s))}</b><small>Chair ${s.chair} · ${esc(shopName(me.shop))}</small></span>
      <span class="u-chip u-chip--${state === 'on' ? 'ok' : state === 'break' ? 'wait' : ''}">${state === 'on' ? 'On shift' : state === 'break' ? 'On a break' : 'Off shift'}</span>`);

    const mine = v.chairs.find((c) => c.id === me.id);
    const next = v.line.find((x) => x.s === 'here');
    const cut = cutMinutes(b);
    const quiet = (label: string, attr: string) => `<button type="button" class="u-btn u-btn--quiet" ${attr}>${label}</button>`;
    let hero: string, dock: string;
    if (state === 'off') {
      hero = '<span class="u-label">Not working</span><p class="u-hero__big">You’re off shift</p><p class="u-hero__time">Customers are not sent to your chair.</p>';
      dock = '<button type="button" class="u-btn u-btn--primary u-btn--lg u-btn--block" data-shift="on">Start my shift</button>';
    } else if (mine?.state === 'busy') {
      const k = b.t[mine.tid!];
      const nm = desk.name(me.shop, mine.tid!) || (k?.src === 'desk' ? 'Walk-in' : 'Online customer');
      const mins = mine.mins ?? 0;
      hero = `<span class="u-label">In your chair</span>
        <div class="u-ring${mins > cut ? ' is-late' : ''}" style="--p:${Math.min(1, mins / cut).toFixed(2)}"><b class="u-num">${mine.n}</b></div>
        <p class="u-hero__who">${esc(nm)}</p>
        <p class="u-hero__time">${mine.calling ? 'Called just now' : `${mins} min so far`} · usual ${cut}</p>`;
      dock = `<button type="button" class="u-btn u-btn--primary u-btn--lg u-btn--block" data-finish>Finish and take payment</button>
        <div>${quiet('Didn’t come', `data-noshow="${mine.tid}"`)}${quiet('Undo call', `data-uncall="${mine.tid}"`)}</div>`;
    } else if (state === 'break') {
      hero = '<span class="u-label">Paused</span><p class="u-hero__big">On a break</p><p class="u-hero__time">Customers are not sent to your chair.</p>';
      dock = `<button type="button" class="u-btn u-btn--primary u-btn--lg u-btn--block" data-brk="off">Back from my break</button><div>${quiet('End my shift', 'data-shift="off"')}</div>`;
    } else if (next) {
      const nm = desk.name(me.shop, next.id) || (b.t[next.id]?.src === 'desk' ? 'Walk-in' : 'Online customer');
      hero = `<span class="u-label">Next for you</span>
        <div class="u-ring" style="--p:0"><b class="u-num">${next.n}</b></div>
        <p class="u-hero__who">${esc(nm)}</p>
        <p class="u-hero__time"><span class="u-chip u-chip--ok">In the shop</span></p>`;
      dock = `<button type="button" class="u-btn u-btn--go u-btn--lg u-btn--block" data-call>Call number ${next.n}</button>
        <div>${quiet('Take a break', 'data-brk="on"')}${quiet('End my shift', 'data-shift="off"')}</div>`;
    } else {
      hero = `<span class="u-label">Ready</span><p class="u-hero__big" style="color:var(--ok)">Your chair is free</p>
        <p class="u-hero__time">${v.onWay ? `${v.onWay} on the way, nobody in the shop yet.` : 'Nobody is waiting.'}</p>`;
      dock = `<div>${quiet('Take a break', 'data-brk="on"')}${quiet('End my shift', 'data-shift="off"')}</div>`;
    }
    fill(chairEl, hero);
    fill(dockEl, dock);

    const mineToday = (takings ?? []).filter((x) => !x.void);
    const sum = (how?: string) => money(mineToday.filter((x) => !how || x.pay === how).reduce((a, x) => a + x.price, 0));
    const cell = (label: string, value: string) => `<div><small>${label}</small><b>${value}</b></div>`;
    fill(todayEl, cell('Cuts', String(s.done)) + (takings === null ? cell('Taken', '—') + cell('Cash', '—') + cell('Online', '—') : cell('Taken', sum()) + cell('Cash', sum('cash')) + cell('Online', sum('online'))));

    const free = state === 'on' && mine?.state === 'free';
    summaryEl.textContent = `${v.inShop} in the shop · ${v.onWay} on the way`;
    $('[data-count]').textContent = String(v.waiting);
    fill(queueEl, v.line.map((x) => {
      const k = b.t[x.id];
      const nm = desk.name(me.shop, x.id);
      const title = nm ? esc(nm) : k.src === 'desk' ? 'Walk-in' : 'Online customer';
      return `<li class="u-row${next?.id === x.id ? ' is-next' : ''}${x.s === 'way' ? ' is-way' : ''}">
        <b class="u-num u-row__n">${x.n}</b>
        <span class="u-row__who"><b>${title}</b>${x.s === 'way' ? `<small>Due ${clockText(x.due)}</small>` : ''}</span>
        <span class="u-row__tags"><span class="u-chip u-chip--${x.s === 'way' ? 'wait' : 'ok'}">${x.s === 'way' ? 'On the way' : 'In the shop'}</span></span>
        <span class="u-row__eta">${minsText(x.mins)}</span>
        <span class="u-row__act">${free ? `<button type="button" class="u-btn u-btn--sm" data-call-id="${x.id}" aria-label="Call number ${x.n} to my chair">Call</button>` : ''}</span>
      </li>`;
    }).join('') || '<li class="u-empty">Nobody waiting</li>');
  };

  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('button');
    if (!t) return;
    const d = t.dataset;
    const shop = me.shop, id = me.id;
    if (d.shop) setMe({ shop: d.shop, id: '' });
    else if (d.me) setMe({ shop, id: d.me });
    else if ('switch' in d) setMe({ shop, id: '' });
    else if ('call' in d) desk.act(shop, (b, now) => callNext(b, id, now));
    else if (d.callId) desk.act(shop, (b, now) => callNext(b, id, now, d.callId));
    else if ('finish' in d) finishAndPay(desk, shop, id, services, toast).then(loadTakings);
    else if ('pw' in d) { pwOpen = !pwOpen; draw(); }
    else if (d.uncall) desk.act(shop, (b, now) => uncall(b, d.uncall!, now));
    else if (d.noshow) { if (confirm('Remove this customer from the queue because they didn’t come?')) desk.act(shop, (b, now) => removeTicket(b, d.noshow!, now)); }
    else if (d.brk) desk.act(shop, (b, now) => setBarber(b, id, { brk: d.brk === 'on' }, now));
    else if (d.shift) desk.act(shop, (b, now) => setBarber(b, id, { on: d.shift === 'on' }, now));
    else if ('out' in d) desk.signOut();
  });
  $<HTMLFormElement>('[data-add]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = (e.target as HTMLFormElement).querySelector<HTMLInputElement>('input')!;
    const name = input.value.trim().replace(/\s+/g, ' ').slice(0, 24);
    const shop = me.shop, id = newId('w');
    input.value = '';
    if (!(await desk.act(shop, (b, now) => addWalkIn(b, id, now)))) { input.value ||= name; return; }
    if (name) desk.setName(shop, id, name);
    toast(`Number ${desk.board(shop).t[id]?.n ?? ''}${name ? ` for ${name}` : ''}: added to the queue`);
  });
  wireSignIn(account, { formId: 'bp-signin' });
  account.addEventListener('submit', async (e) => {
    const form = e.target as HTMLFormElement;
    if (form.id !== 'bp-pw') return; // signing in is handled by the shared sign-in block
    e.preventDefault();
    const f = new FormData(form);
    {
      try { await changePassword(String(f.get('pw'))); pwOpen = false; accountMsg = 'Password changed.'; }
      catch (err) { accountMsg = /recent-login/.test(String((err as { code?: string }).code)) ? 'For safety, sign out, sign in again, and then change the password.' : 'Could not change the password. Use 8 or more characters and try again.'; }
      draw();
      return;
    }
  });

  draw();
  setInterval(draw, 15_000);
  setInterval(loadTakings, 120_000);
</script>
