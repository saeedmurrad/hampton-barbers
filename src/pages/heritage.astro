---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Status from '../components/Status.astro';
import SpecialHours from '../components/SpecialHours.astro';
import Hours from '../components/Hours.astro';
import { site, menu } from '../data/site';
import { renderMenu } from '../lib/menu';
import Map from '../components/Map.astro';
import StyleGallery from '../components/StyleGallery.astro';
import ShopPhotos from '../components/ShopPhotos.astro';
import shave from '../assets/photos/shave.jpg';
import shopfront from '../assets/photos/shopfront.jpg';
import cut4 from '../assets/photos/cut-4.jpg';

const isDemo = import.meta.env.PUBLIC_DEMO !== 'false';
---
<Base title="Hampton Barbers | Walk-in barber shop in Hampton Vale, Peterborough" design="heritage" themeColor="#12100e">
  <div class="top"><div class="wrap"><span>Open seven days. Late until 8pm on weekdays.</span><a href={site.phoneHref}>{site.phone}</a></div></div>
  <header class="head">
    <div class="wrap head__in">
      <nav aria-label="Main"><a href="#story">Our story</a><a href="#prices">Price list</a></nav>
      <a class="crest" href="#top"><span>Hampton Barbers</span><small>Established {site.since}</small></a>
      <nav aria-label="More"><a href="#work">Styles</a><a href="#visit">Find us</a></nav>
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <Image src={shave} alt="A barber giving a customer a cut throat shave" widths={[640, 1024, 1600, 1920]} sizes="100vw" loading="eager" fetchpriority="high" quality={70} />
      <div class="hero__in">
        <p class="place up">Hampton Vale, Peterborough</p>
        <span class="rule up" aria-hidden="true"></span>
        <h1 class="up" style="--i:1">Walk-in barbers <em>in Hampton Vale</em></h1>
        <p class="sub up" style="--i:2">No appointment required. Come in during opening hours and we’ll see you as soon as a chair is free.</p>
        <div class="btns up" style="--i:3"><a class="btn" href={site.phoneHref}>Call {site.phone}</a><a class="btn btn--line" href={site.directionsUrl} rel="noopener">Get directions</a></div>
        <Status class="up" />
      </div>
    </section>

    <section class="story wrap" id="story">
      <div class="story__img" data-reveal="img"><Image src={shopfront} alt="The Hampton Barbers shop front on Four Chimneys Crescent" widths={[360, 640]} sizes="(max-width: 900px) 90vw, 25vw" /></div>
      <div class="story__text" data-reveal style="--d:1">
        <h2>Part of Hampton since {site.since}</h2>
        <p>We opened in the heart of Hampton Vale in {site.since}. Plenty of the lads who had their first proper haircut with us now bring their own children in.</p>
        <p>Our barbers have more than thirty years of experience between them. Skin fades, scissor cuts, cut throat finishes and beard trims. Show us a photo, or just tell us roughly what you are after.</p>
        <p class="sign">Seven days a week. No appointment, ever.</p>
      </div>
      <div class="story__img story__img--low" data-reveal="img" style="--d:2"><Image src={cut4} alt="A sharp skin fade cut at Hampton Barbers, seen from the back" widths={[360, 640, 900]} sizes="(max-width: 900px) 90vw, 25vw" /></div>
    </section>

    <section class="menu" id="prices">
      <div class="card" data-reveal>
        <h2>Price List</h2>
        <p class="card__sub">Something for everyone</p>
        <div data-menu="heritage" set:html={renderMenu('heritage', menu)} />
        {isDemo && <p class="demo">Demo note: these are the shop’s 2022 prices and will be updated with the owner.</p>}
      </div>
    </section>

    <section class="inside wrap" aria-labelledby="inside-h">
      <h2 id="inside-h" data-reveal>Inside the shop</h2>
      <ShopPhotos class="inside__photos" reveal="develop" />
    </section>

    <section class="work wrap" id="work">
      <h2 data-reveal>Find your style</h2>
      <p class="work__sub" data-reveal style="--d:1">Point at a plate and show it to your barber.</p>
      <StyleGallery variant="heritage" />
    </section>

    <section class="praise wrap" data-reveal>
      <p class="praise__stars" aria-hidden="true">★★★★☆</p>
      <blockquote>“Been going here since I was 7 years old, 25 now.”</blockquote>
      <p>Rated {site.rating.value} out of 5 from {site.rating.count} reviews on Google. <a href={site.reviewsUrl} rel="noopener">Read them</a></p>
    </section>

    <section class="visit" id="visit">
      <div class="wrap visit__in">
        <div data-reveal>
          <h2>Opening hours</h2>
          <SpecialHours />
          <Hours />
        </div>
        <div data-reveal style="--d:1">
          <h2>Where we are</h2>
          <address>{site.address.street}<br />{site.address.locality}, {site.address.city}<br />{site.address.postcode}</address>
          <p class="note">In the centre of Hampton Vale, with public parking directly opposite.</p>
          <a class="tel" href={site.phoneHref}>{site.phone}</a>
          <div class="btns"><a class="btn" href={site.directionsUrl} rel="noopener">Get directions</a></div>
        </div>
      </div>
      <div class="wrap" data-reveal><Map class="vmap" /></div>
    </section>
  </main>

  <footer class="foot">
    <p class="foot__name">Hampton Barbers</p>
    <p><a href={site.facebook} rel="noopener">Facebook</a><a href={site.instagram} rel="noopener">Instagram</a><a href={site.reviewsUrl} rel="noopener">Google reviews</a></p>
    <p class="small">© {new Date().getFullYear()} {site.company}</p>
  </footer>
</Base>

<style is:global>
  body.heritage {
    --bg: #12100e; --surface: #1a1714; --text: #f3ead9; --muted: #b5aa94; --accent: #c9a25d; --on-accent: #14110d; --line: #3a332a;
    --display: 'Playfair Display Variable', Georgia, serif; --dw: 600; --radius: 0;

    .top { border-bottom: 1px solid var(--line); font-size: .78rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
    .top .wrap { display: flex; justify-content: space-between; gap: 1rem; padding-block: .6rem; }
    .top a { color: var(--accent); text-decoration: none; font-weight: 600; }
    .head { position: sticky; top: 0; z-index: 40; background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
    .head__in { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding-block: .9rem; }
    .head nav { display: flex; gap: 2.5rem; font-size: .8rem; letter-spacing: .16em; text-transform: uppercase; }
    .head nav:last-child { justify-content: flex-end; }
    .head nav a { text-decoration: none; transition: color .2s; }
    .head nav a:hover { color: var(--accent); }
    .crest { display: grid; justify-items: center; gap: .3rem; text-decoration: none; }
    .crest span { font-family: var(--display); font-size: 1.35rem; letter-spacing: .14em; text-transform: uppercase; line-height: 1; }
    .crest small { font-size: .6rem; letter-spacing: .34em; text-transform: uppercase; color: var(--accent); }

    .hero { position: relative; min-height: min(86svh, 54rem); display: grid; place-items: center; text-align: center; overflow: clip; isolation: isolate; }
    .hero > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 55% 30%; z-index: -2; filter: saturate(.8); animation: slowzoom 16s ease-out both; }
    .hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(ellipse at center, rgb(18 16 14 / .48) 0%, rgb(18 16 14 / .72) 80%), linear-gradient(0deg, var(--bg), transparent 30%); }
    .hero__in { padding: 4rem 1.25rem; display: grid; justify-items: center; gap: 1.5rem; }
    .place { font-size: .8rem; letter-spacing: .3em; text-transform: uppercase; color: var(--accent); }
    .hero h1 { font-size: clamp(3.2rem, 10vw, 8.5rem); }
    .hero h1 em { display: block; font-style: italic; color: var(--accent); font-weight: 400; }
    .sub { max-width: 30rem; font-size: 1.15rem; }
    .hero .btns { justify-content: center; }

    .story { display: grid; grid-template-columns: 1fr 1.3fr 1fr; gap: clamp(1.5rem, 4vw, 4rem); align-items: start; padding-block: clamp(5rem, 10vw, 9rem); }
    .story__img { overflow: hidden; border: 1px solid var(--accent); padding: .5rem; }
    .story__img img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
    .story__img--low img { object-position: 50% 30%; }
    .story__img--low { margin-top: 6rem; }
    .story__text { text-align: center; display: grid; gap: 1.25rem; padding-top: 2rem; }
    .story h2 { font-size: clamp(2.2rem, 4.5vw, 3.6rem); margin-bottom: .5rem; }
    .story__text p { color: var(--muted); }
    .story__text .sign { font-family: var(--display); font-style: italic; font-size: 1.5rem; color: var(--text); margin-top: 1rem; }

    .menu { background: var(--surface); --cover: var(--surface); padding: clamp(4rem, 9vw, 8rem) 1.25rem; }
    .card { max-width: 62rem; margin-inline: auto; border: 1px solid var(--accent); outline: 1px solid var(--accent); outline-offset: 7px; padding: clamp(2rem, 6vw, 4.5rem); text-align: center; }
    .card h2 { font-size: clamp(2.6rem, 7vw, 5rem); font-style: italic; font-weight: 400; }
    .card__sub { letter-spacing: .3em; text-transform: uppercase; font-size: .78rem; color: var(--accent); margin-top: 1rem; }
    .mcat { margin-top: 2.75rem; text-align: left; }
    .mcat__h { text-align: center; font-size: 1.5rem; font-style: italic; font-weight: 400; color: var(--accent); margin-bottom: .5rem; }
    .cols { columns: 2; column-gap: clamp(2rem, 5vw, 4rem); }
    .cols li { padding-block: .95rem; break-inside: avoid; }
    .row { display: flex; align-items: baseline; gap: .7rem; }
    .row h4 { font-family: var(--display); font-size: 1.3rem; font-weight: 500; }
    .row i { flex: 1; border-bottom: 2px dotted var(--line); transform: translateY(-.3em); }
    .row b { font-family: var(--display); font-size: 1.3rem; color: var(--accent); }
    .cols li p { color: var(--muted); font-size: .9rem; margin-top: .2rem; }
    .vmap { margin-top: clamp(2.5rem, 6vw, 4.5rem); min-height: clamp(18rem, 40vw, 26rem); border: 1px solid var(--accent); outline: 1px solid var(--accent); outline-offset: 6px; }
    .vmap iframe { filter: grayscale(.5) invert(.92) hue-rotate(180deg) sepia(.25) contrast(.95); }
    .demo { margin-top: 2.5rem; font-size: .82rem; color: var(--muted); }

    .work { padding-block: clamp(5rem, 10vw, 9rem); text-align: center; }
    .work h2 { font-size: clamp(2.2rem, 5vw, 4rem); margin-bottom: 3rem; }
    .work__sub { color: var(--muted); font-style: italic; margin: -2rem 0 3rem; }
    .inside { padding-bottom: clamp(3rem, 7vw, 6rem); text-align: center; }
    .inside h2 { font-size: clamp(2rem, 4.5vw, 3.4rem); font-style: italic; font-weight: 400; margin-bottom: 2.5rem; }
    .inside .shop-photos figure { border: 1px solid var(--line); padding: .4rem; }
    .inside .shop-photos figcaption { font-family: var(--display); font-style: italic; font-size: 1rem; text-align: center; }
    .rule { display: block; width: 7rem; height: 1px; background: var(--accent); transform-origin: 50% 50%; animation: rule 1.6s cubic-bezier(.7,0,.2,1) .4s both; }
    .hero h1.up { animation: ink 2s cubic-bezier(.2,.7,.2,1) both; animation-delay: .5s; }
    .hero .up:not(h1):not(.rule) { animation: inkfade 1.6s ease both; animation-delay: calc(var(--i, 0) * .25s + .9s); }
    .work figure { overflow: hidden; border: 1px solid var(--line); padding: .4rem; }
    .work img { width: 100%; aspect-ratio: 1; object-fit: cover; filter: saturate(.75); }
    .work figure:hover img { filter: none; }

    .praise { text-align: center; padding-bottom: clamp(5rem, 10vw, 9rem); display: grid; gap: 1.25rem; justify-items: center; }
    .praise__stars { color: var(--accent); letter-spacing: .4em; }
    .praise blockquote { font-family: var(--display); font-style: italic; font-size: clamp(1.9rem, 4.6vw, 3.6rem); line-height: 1.15; max-width: 22ch; }
    .praise p:last-child { color: var(--muted); }

    .visit { background: var(--surface); padding-block: clamp(4rem, 9vw, 8rem); }
    .visit__in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.5rem, 7vw, 7rem); }
    .visit h2 { font-size: clamp(1.9rem, 4vw, 2.8rem); margin-bottom: 1.5rem; font-style: italic; font-weight: 400; }
    .visit address { font-size: 1.2rem; }
    .note { color: var(--muted); margin-top: 1rem; }
    .tel { display: block; font-family: var(--display); font-size: clamp(2.2rem, 5vw, 3.4rem); color: var(--accent); text-decoration: none; margin-block: 1.25rem 1.75rem; }

    .foot { text-align: center; padding: 4rem 1.25rem 6rem; display: grid; gap: 1.1rem; }
    .foot__name { font-family: var(--display); font-size: 2rem; letter-spacing: .14em; text-transform: uppercase; }
    .foot a { margin-inline: .8rem; }
    .small { color: var(--muted); font-size: .85rem; }

    @media (max-width: 900px) {
      .head nav { display: none; }
      .head__in { grid-template-columns: 1fr; justify-items: center; }
      .top span { display: none; } .top .wrap { justify-content: center; }
      .story { grid-template-columns: 1fr 1fr; }
      .story__text { grid-column: 1 / -1; grid-row: 1; padding-top: 0; }
      .story__img--low { margin-top: 2.5rem; }
      .cols { columns: 1; } .visit__in { grid-template-columns: 1fr; }
      .work__grid { grid-template-columns: 1fr 1fr; }
    }
  }
  @keyframes rule { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes ink { from { opacity: 0; letter-spacing: .14em; filter: blur(10px); } to { opacity: 1; letter-spacing: normal; filter: none; } }
  @keyframes inkfade { from { opacity: 0; filter: blur(6px); } to { opacity: 1; filter: none; } }
  @keyframes slowzoom { from { transform: scale(1.14); } to { transform: scale(1); } }
</style>
