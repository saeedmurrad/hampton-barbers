---
// The queue desk: the shop's own screen for running the queue. Add walk-ins, mark online
// customers as arrived, call people to a chair, finish cuts and record how they paid, and
// (under Barbers and Settings) manage barber profiles, staff logins and the queue's settings.
import '../../styles/ui.css';
import '../../styles/staff.css';
import Base from '../../layouts/Base.astro';
import { shops, menu } from '../../data/site';
import { penceOf } from '../../lib/sales';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const services = menu.flatMap((c) => c.items.map((i) => ({ name: i.name, price: penceOf(i.price) })));
const icons = {
  queue: 'M8 6h12M8 12h12M8 18h12M3.5 6h.01M3.5 12h.01M3.5 18h.01',
  barbers: 'M16 8a4 4 0 1 1-8 0 4 4 0 0 1 8 0ZM4 21a8 8 0 0 1 16 0',
  reports: 'M5 20V10M12 20V4M19 20v-7',
  settings: 'M4 7h10M18 7h2M4 17h4M12 17h8M14 7a2 2 0 1 0 4 0 2 2 0 0 0-4 0ZM8 17a2 2 0 1 0 4 0 2 2 0 0 0-4 0Z',
};
---
<Base noindex title="Hampton Barbers: queue desk" description="Run the walk-in queue: add walk-ins, call customers to a chair and keep the shop screen up to date." themeColor="#0a0c0b">
  <main id="main" class="ui" data-desk data-base={base} data-services={JSON.stringify(services)}>
    <h1 class="sr">Queue desk</h1>
    <header class="u-top">
      <a class="u-brand" href={`${base}/`}><i>HB</i><span><b>Hampton Barbers</b><small>Queue desk</small></span></a>
      <nav class="u-seg" aria-label="Which shop">
        {shops.map((s, i) => <button type="button" data-tab={s.id} aria-pressed={i === 0 ? 'true' : 'false'}><span>{s.name}</span></button>)}
      </nav>
      <div class="u-top__right">
        <nav class="u-nav" aria-label="Sections">
          <a href="#queue" data-view-link="queue" aria-current="page">Queue</a>
          <a href="#barbers" data-view-link="barbers">Barbers</a>
          <a href="#settings" data-view-link="settings">Settings</a>
          <a href={`${base}/admin/reports/`}>Reports</a>
        </nav>
        <span class="u-live" data-live><i></i><span>Demo</span></span>
        <time data-clock></time>
      </div>
    </header>

    <div class="u-desk__body">
      <p class="u-status" id="qd-status" role="status" aria-live="polite">Loading…</p>
      <section class="u-acct" id="qd-account" aria-label="Your account"></section>
      <p class="u-banner" data-banner hidden></p>

      <div class="u-stack" data-view="queue">
        <section class="u-stats" aria-label="Right now" data-stats></section>
        <div class="u-main">
          <section class="u-panel" aria-labelledby="qd-h-chairs">
            <div class="u-h"><h2 id="qd-h-chairs">Chairs</h2><span data-summary></span></div>
            <div class="u-chairs" data-chairs></div>
          </section>
          <section class="u-panel" aria-labelledby="qd-h-line">
            <div class="u-h">
              <h2 id="qd-h-line">Waiting <em data-count>0</em></h2>
              <form class="u-add" data-add>
                <input name="name" maxlength="24" autocomplete="off" placeholder="Walk-in’s first name (optional)" aria-label="Walk-in’s first name (optional)" />
                <button type="submit" class="u-btn u-btn--primary">Add walk-in</button>
              </form>
            </div>
            <ol class="u-line" data-queue></ol>
          </section>
        </div>
      </div>

      <div class="u-stack" data-view="barbers" hidden>
        <section class="u-panel" aria-labelledby="qd-h-barbers">
          <div class="u-h"><h2 id="qd-h-barbers">Barbers at this shop</h2><button type="button" class="u-btn" data-add-barber>Add a barber</button></div>
          <p class="u-hint" style="margin-bottom:.9rem">Each barber has their own profile and chair. Customers are assigned to a barber when they are called.</p>
          <ul class="u-staff" data-staff></ul>
        </section>
        <section class="u-panel" aria-labelledby="qd-h-logins" data-logins hidden>
          <div class="u-h"><h2 id="qd-h-logins">Staff logins</h2></div>
          <p class="u-hint" style="margin-bottom:.9rem">Give each barber their own login, and one for the shop tablet. A staff login can run the queue and record payments. It cannot open the takings, the percentages or this list.</p>
          <ul class="u-staff" data-login-list></ul>
          <form class="u-form" data-new-login style="margin-top:.9rem">
            <input class="u-input" name="name" placeholder="First name" required maxlength="30" autocomplete="off" aria-label="First name" />
            <input class="u-input" name="email" type="email" placeholder="Their email" required autocomplete="off" aria-label="Their email" />
            <input class="u-input" name="password" type="text" placeholder="A password for them" required minlength="8" autocomplete="off" aria-label="A password for them, 8 or more characters" />
            <select class="u-input" name="for" aria-label="Who the login is for" data-login-for></select>
            <button type="submit" class="u-btn u-btn--primary">Create login</button>
          </form>
          <p class="u-hint" style="margin-top:.7rem">They sign in on the barber panel with that email and password, and can change the password there. No email is sent.</p>
          <p class="u-msg" data-login-msg role="status" hidden></p>
        </section>
      </div>

      <div class="u-stack" data-view="settings" hidden>
        <div class="u-cols">
          <section class="u-panel u-stack" aria-labelledby="qd-h-settings">
            <div class="u-h" style="margin-bottom:0"><h2 id="qd-h-settings">Queue settings</h2></div>
            <div class="u-rowline">
              <span><b>Usual minutes per cut</b><small>Used for the wait estimates. Timed cuts fine-tune it through the day.</small></span>
              <div class="u-step"><button type="button" class="u-btn" data-avg="-5" aria-label="Fewer minutes per cut">−</button><output data-avg-val>20</output><button type="button" class="u-btn" data-avg="5" aria-label="More minutes per cut">+</button></div>
            </div>
            <label class="u-field">Joining from a phone
              <select class="u-input" id="qd-online">
                <option value="on">On: customers can join from their phones</option>
                <option value="off">Paused: walk-ins only</option>
              </select>
            </label>
            <label class="u-field">How busy we look
              <select class="u-input" id="qd-mode">
                <option value="auto">Work it out from the queue (recommended)</option>
                <option value="quiet">Quiet: walk straight in</option>
                <option value="steady">Short wait</option>
                <option value="busy">Busy</option>
                <option value="very-busy">Very busy</option>
                <option value="paused">Not cutting right now (break or closing)</option>
              </select>
            </label>
            <label class="u-field">Short message for customers (optional)
              <input class="u-input" id="qd-note" maxlength="120" placeholder="e.g. Back from lunch at 2pm" />
            </label>
          </section>
          <div class="u-stack">
            <section class="u-panel" aria-labelledby="qd-h-screens">
              <div class="u-h"><h2 id="qd-h-screens">Screens for this shop</h2></div>
              <div class="u-links" data-links></div>
            </section>
            <section class="u-panel u-stack" aria-labelledby="qd-h-tidy">
              <div class="u-h" style="margin-bottom:0"><h2 id="qd-h-tidy">Clean-up</h2></div>
              <div class="u-rowline" data-demo-only>
                <span><b>Fill the demo queue with an example</b><small>Only in the demo. Replaces the queue on this device.</small></span>
                <div class="u-step"><button type="button" class="u-btn u-btn--sm" style="width:auto;border-radius:10px;font-size:.85rem" data-example="quiet">Quiet</button><button type="button" class="u-btn u-btn--sm" style="width:auto;border-radius:10px;font-size:.85rem" data-example="steady">Steady</button><button type="button" class="u-btn u-btn--sm" style="width:auto;border-radius:10px;font-size:.85rem" data-example="busy">Busy</button></div>
              </div>
              <div class="u-rowline">
                <span><b>Clear the queue</b><small>Removes everyone waiting and in the chairs. Ticket numbers carry on.</small></span>
                <button type="button" class="u-btn" data-clear>Clear the queue</button>
              </div>
            </section>
          </div>
        </div>
      </div>
    </div>

    <nav class="u-tabbar" aria-label="Sections">
      <a href="#queue" data-view-link="queue" aria-current="page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons.queue} /></svg>Queue</a>
      <a href="#barbers" data-view-link="barbers"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons.barbers} /></svg>Barbers</a>
      <a href={`${base}/admin/reports/`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons.reports} /></svg>Reports</a>
      <a href="#settings" data-view-link="settings"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons.settings} /></svg>Settings</a>
    </nav>

    <dialog class="u-sheet" data-sheet aria-label="More actions"><div class="u-sheet__in"><b data-sheet-title></b><div class="u-stack" style="gap:.45rem" data-sheet-acts></div><button type="button" class="u-btn u-btn--quiet" data-sheet-close>Cancel</button></div></dialog>
  </main>
</Base>

<script>
  import { addWalkIn, arrive, barberLabel, boardView, callNext, clearQueue, clockText, cutMinutes, dropBarber, exampleBoard, lapsed, minsText, removeTicket, setBarber, setOptions, uncall, type LiveMode } from '../../lib/board';
  import { createDesk } from '../../lib/desk';
  import { finishAndPay, loadServices, type Service } from '../../lib/paysheet';
  import { signInHtml, wireSignIn } from '../../lib/signin';
  import { customerContact } from '../../lib/cloud';
  import { esc, newId } from '../../lib/store';
  import * as cloud from '../../lib/cloud';

  const root = document.querySelector<HTMLElement>('[data-desk]')!;
  let services = JSON.parse(root.dataset.services || '[]') as Service[];
  loadServices(services).then((list) => { services = list; });
  const base = root.dataset.base ?? '';
  const emu = new URLSearchParams(location.search).has('emulator');
  const tabs = [...document.querySelectorAll<HTMLElement>('[data-tab]')];
  const shops = tabs.map((b) => ({ id: b.dataset.tab!, name: b.textContent!.trim() }));
  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const statusEl = $('#qd-status'), account = $('#qd-account'), linksEl = $('[data-links]'), bannerEl = $('[data-banner]');
  const chairsEl = $('[data-chairs]'), queueEl = $('[data-queue]'), staffEl = $('[data-staff]'), summaryEl = $('[data-summary]'), statsEl = $('[data-stats]');
  const modeEl = $<HTMLSelectElement>('#qd-mode'), onlineEl = $<HTMLSelectElement>('#qd-online'), noteEl = $<HTMLInputElement>('#qd-note');
  const sheet = $<HTMLDialogElement>('[data-sheet]');
  const fill = (el: HTMLElement, html: string) => { if (el.dataset.html !== html) { el.innerHTML = html; el.dataset.html = html; } };
  const shopName = (id: string) => shops.find((s) => s.id === id)?.name ?? 'the shop';

  let tab = shops.find((s) => s.id === new URLSearchParams(location.search).get('shop'))?.id ?? shops[0].id;
  let accountMsg = '';
  let drawnFor: string | null | undefined;
  const known: Record<string, Set<string>> = {}; // tickets already seen, so new online joiners can be announced
  let logins: cloud.StaffInfo[] | null = null;   // staff logins, loaded for the owner only
  let loginsAsked = false;
  const loginsEl = $('[data-logins]'), loginList = $('[data-login-list]'), loginFor = $<HTMLSelectElement>('[data-login-for]'), loginMsg = $('[data-login-msg]');
  const reloadLogins = () => { loginsAsked = true; cloud.listStaff().then((list) => { logins = list; draw(); }).catch(() => { logins = []; draw(); }); };

  const toast = (msg: string, action?: { label: string; run: () => void }) => {
    document.querySelector('.staff-toast')?.remove();
    const t = Object.assign(document.createElement('p'), { className: 'staff-toast' });
    t.setAttribute('role', 'status');
    t.append(msg);
    if (action) {
      const b = Object.assign(document.createElement('button'), { type: 'button', textContent: action.label });
      b.addEventListener('click', () => { t.remove(); action.run(); });
      t.append(b);
    }
    document.body.append(t);
    setTimeout(() => t.remove(), action ? 12_000 : 4500);
  };

  // The three sections of the desk. Only one shows at a time; the others stay in the page.
  const showView = (name: string) => {
    document.querySelectorAll<HTMLElement>('[data-view]').forEach((el) => { el.hidden = el.dataset.view !== name; });
    document.querySelectorAll<HTMLElement>('[data-view-link]').forEach((a) => { if (a.dataset.viewLink === name) a.setAttribute('aria-current', 'page'); else a.removeAttribute('aria-current'); });
  };
  // A small sheet of extra actions for one chair or one person in the line.
  const openSheet = (title: string, acts: { label: string; attr: string; danger?: boolean }[]) => {
    $('[data-sheet-title]').textContent = title;
    $('[data-sheet-acts]').innerHTML = acts.map((a) => `<button type="button" class="u-btn${a.danger ? ' u-btn--danger' : ''}" ${a.attr}>${esc(a.label)}</button>`).join('');
    sheet.showModal();
  };

  const desk = createDesk(shops.map((s) => s.id), () => draw());

  // ---------- drawing ----------
  const drawAccount = () => {
    const email = desk.email();
    if (drawnFor === email && !accountMsg) return;
    drawnFor = email;
    const note = accountMsg ? `<p class="u-msg" role="alert" style="margin-top:.6rem">${esc(accountMsg)}</p>` : '';
    accountMsg = '';
    account.classList.toggle('u-acct--line', Boolean(email));
    if (!desk.connected) { account.innerHTML = '<p><strong>Not connected.</strong> Changes show on this device only.</p>'; return; }
    account.innerHTML = email
      ? `<p>Signed in as <strong>${esc(email)}</strong>. Every change goes live straight away on the website, the barbers’ phones and the shop TV. <button type="button" class="u-link" data-out>Sign out</button></p>${note}`
      : `<details${note ? ' open' : ''}><summary>Sign in to run the real queue</summary>
          ${signInHtml({ formId: 'qd-signin' })}${note}
        <p class="u-hint" style="margin-top:.7rem">Until you sign in this is a demo that stays on this device: open the shop TV, a barber panel and a customer page in other tabs and they all follow along.</p></details>`;
  };

  const draw = () => {
    const now = Date.now();
    const b = desk.board(tab, now);
    const v = boardView(b, now);
    const signedIn = Boolean(desk.email());
    const offline = desk.offline(tab);
    statusEl.textContent = offline ? 'No connection. Showing the last known queue.' : desk.status();
    $('[data-clock]').textContent = clockText(now);
    const live = $('[data-live]');
    live.lastElementChild!.textContent = !signedIn ? 'Demo' : offline ? 'Offline' : 'Live';
    live.style.color = !signedIn ? 'var(--wait)' : offline ? 'var(--alert)' : '';
    drawAccount();

    // Announce people who joined on their phones since the last look.
    for (const s of shops) {
      const ids = Object.entries(desk.board(s.id, now).t);
      if (known[s.id]) for (const [id, k] of ids) if (!known[s.id].has(id) && k.src !== 'desk' && now - k.at < 30_000) toast(`Number ${k.n} joined ${k.src === 'qr' ? 'at the door' : 'online'} for ${s.name}`);
      known[s.id] = new Set(ids.map(([id]) => id));
    }
    tabs.forEach((btn) => {
      const id = btn.dataset.tab!;
      btn.setAttribute('aria-pressed', String(id === tab));
      const n = boardView(desk.board(id, now), now).waiting;
      const badge = btn.querySelector('em');
      if (String(n || '') !== (badge?.textContent ?? '')) { badge?.remove(); if (n) btn.insertAdjacentHTML('beforeend', `<em title="People waiting">${n}</em>`); }
    });
    const q = emu ? '?emulator' : '';
    fill(linksEl, `
      <a class="u-btn" href="${base}/board/${tab}/${q}" target="_blank" rel="noopener">Shop TV</a>
      <a class="u-btn" href="${base}/barber/?shop=${tab}${emu ? '&emulator' : ''}" target="_blank" rel="noopener">Barber panel</a>
      <a class="u-btn" href="${base}/queue/${tab}/${q}" target="_blank" rel="noopener">Customer page</a>
      <a class="u-btn" href="${base}/queue/${tab}/?here=1${emu ? '&emulator' : ''}" target="_blank" rel="noopener">Door code link</a>
      <a class="u-btn" href="${base}/poster/${tab}/" target="_blank" rel="noopener">Door poster</a>`);
    const loading = desk.loading(tab);
    const closed = signedIn && !loading && !desk.opened(tab);
    bannerEl.hidden = !closed;
    if (closed) fill(bannerEl, `<span>Today’s queue for ${esc(shopName(tab))} is not open yet, so customers cannot see or join it.</span> <button type="button" class="u-btn u-btn--primary" data-open>Open today’s queue</button>`);

    if (loading) {
      summaryEl.textContent = '';
      fill(statsEl, '');
      fill(chairsEl, '<p class="u-empty">Loading the queue…</p>');
      fill(queueEl, '<li class="u-empty">Loading the queue…</li>');
      return;
    }
    const wait = v.headline === 'No wait' ? 'None' : v.headline;
    fill(statsEl, `<div class="u-stat"><span class="u-label">In the shop</span><b>${v.inShop}</b></div>
      <div class="u-stat"><span class="u-label">On the way</span><b>${v.onWay}</b></div>
      <div class="u-stat${v.level >= 3 ? ' u-stat--wait' : ''}"><span class="u-label">Walk-in wait</span><b>${wait}${v.unit ? `<small>${v.unit}</small>` : ''}</b></div>
      <div class="u-stat"><span class="u-label">Cuts today</span><b>${b.done}</b></div>`);
    const cutting = v.chairs.filter((c) => c.state !== 'break').length, onBreak = v.chairs.length - cutting;
    summaryEl.textContent = `${cutting} on shift${onBreak ? ` · ${onBreak} on a break` : ''}`;
    $('[data-count]').textContent = String(v.waiting);

    const next = v.line.find((x) => x.s === 'here');
    const cut = cutMinutes(b);
    fill(chairsEl, v.chairs.map((c) => {
      const s = b.staff[c.id];
      const who = esc(barberLabel(s));
      const avatar = `<span class="u-avatar u-avatar--sm">${esc(barberLabel(s)[0].toUpperCase())}</span>`;
      const more = `<button type="button" class="u-btn u-btn--icon" data-more="chair:${c.id}" aria-label="More for ${who}">⋯</button>`;
      if (c.state === 'busy') {
        const k = b.t[c.tid!];
        const nm = desk.name(tab, c.tid!) || (k?.src === 'desk' ? 'Walk-in' : 'Online customer');
        const mins = c.mins ?? 0, late = mins > cut;
        return `<article class="u-chair is-busy${late ? ' is-late' : ''}${c.calling ? ' is-calling' : ''}">
          <p class="u-num u-chair__num">${c.n}</p>
          <div class="u-chair__who">${avatar}<b>${who}</b><small>Chair ${c.chair} · ${esc(nm)}</small></div>
          <div class="u-bar"><i style="width:${Math.min(100, Math.round(mins / cut * 100))}%"></i></div>
          <p class="u-chair__meta"><span>${c.calling ? 'Called just now' : `${mins} min so far`}</span><span>${late ? `${mins - cut} min over` : `${cut - mins} min left`}</span></p>
          <div class="u-chair__act"><button type="button" class="u-btn u-btn--primary" data-finish="${c.id}">Finish</button>${more}</div>
        </article>`;
      }
      if (c.state === 'break') return `<article class="u-chair is-break">
          <p class="u-num u-chair__num">Break</p>
          <div class="u-chair__who">${avatar}<b>${who}</b><small>Chair ${c.chair} · not taking customers</small></div>
          <div class="u-chair__act"><button type="button" class="u-btn" data-brk-off="${c.id}">End break</button>${more}</div>
        </article>`;
      return `<article class="u-chair is-free">
          <p class="u-num u-chair__num">Free</p>
          <div class="u-chair__who">${avatar}<b>${who}</b><small>Chair ${c.chair} · ${next ? `next is ${next.n}` : v.onWay ? 'nobody in the shop yet' : 'nobody waiting'}</small></div>
          <div class="u-chair__act"><button type="button" class="u-btn${next ? ' u-btn--go' : ''}" data-call="${c.id}">${next ? `Call ${next.n}` : 'Call next'}</button>${more}</div>
        </article>`;
    }).join('') || '<p class="u-empty">No barbers are on shift. Open “Barbers” to put someone on shift.</p>');

    fill(queueEl, v.line.map((x) => {
      const k = b.t[x.id];
      const nm = desk.name(tab, x.id);
      const title = nm ? esc(nm) : k.src === 'desk' ? 'Walk-in' : 'Online customer';
      const waited = Math.max(0, Math.round((now - (k.arr ?? k.at)) / 60_000));
      const sub = x.s === 'way' ? `Due ${clockText(x.due)}${k.late ? ' · running late' : ''}`
        : `${k.src !== 'desk' ? 'Joined on their phone · w' : nm ? 'Walk-in · w' : 'W'}aiting ${waited} min`;
      const first = next?.id === x.id;
      return `<li class="u-row${first ? ' is-next' : ''}${x.s === 'way' ? ' is-way' : ''}">
        <b class="u-num u-row__n">${x.n}</b>
        <span class="u-row__who"><b>${title}</b><small>${sub}</small></span>
        <span class="u-row__tags"><span class="u-chip u-chip--${x.s === 'way' ? 'wait' : 'ok'}">${x.s === 'way' ? 'On the way' : 'In the shop'}</span></span>
        <span class="u-row__eta">${minsText(x.mins)}</span>
        <span class="u-row__act">${x.s === 'way'
          ? `<button type="button" class="u-btn u-btn--sm" data-arrived="${x.id}">Arrived</button>`
          : `<button type="button" class="u-btn u-btn--sm${first ? ' u-btn--primary' : ''}" data-seat="${x.id}">Seat</button>`}<button type="button" class="u-btn u-btn--icon u-btn--sm" data-more="row:${x.id}" aria-label="More for number ${x.n}">⋯</button></span>
      </li>`;
    }).join('') || '<li class="u-empty">Nobody waiting</li>');

    if (!staffEl.contains(document.activeElement)) {
      fill(staffEl, Object.entries(b.staff).sort((x, y) => x[1].chair - y[1].chair).map(([id, s]) => `<li data-barber="${id}">
        <label class="is-num">Chair<input class="u-input" type="number" min="1" max="30" value="${s.chair}" data-f="chair" /></label>
        <label class="is-grow">Name<input class="u-input" maxlength="20" value="${esc(s.name)}" placeholder="First name" data-f="name" /></label>
        <label class="is-check"><input type="checkbox" ${s.on ? 'checked' : ''} data-f="on" />On shift</label>
        <span class="is-done">${s.done} cut${s.done === 1 ? '' : 's'} today</span>
        <button type="button" class="u-btn u-btn--sm" data-drop-barber="${id}" aria-label="Remove ${esc(s.name || `the barber on chair ${s.chair}`)}">Remove</button></li>`).join('') || '<li class="u-empty">No barbers yet.</li>');
    }
    $('[data-avg-val]').textContent = String(b.avg);
    modeEl.value = b.mode;
    onlineEl.value = b.online ? 'on' : 'off';
    if (document.activeElement !== noteEl) noteEl.value = b.note;
    $('[data-demo-only]').hidden = signedIn;

    // Staff logins are the owner's business only.
    const isOwner = desk.role() === 'owner';
    loginsEl.hidden = !isOwner;
    if (!isOwner) { logins = null; loginsAsked = false; return; }
    if (!loginsAsked) reloadLogins();
    const chairOf = (l: cloud.StaffInfo) => { const x = desk.board(l.shop, now).staff[l.b]; return x ? `chair ${x.chair}${x.name ? `, ${esc(x.name)}` : ''}` : 'a profile that has been removed'; };
    fill(loginList, logins === null ? '<li class="u-empty">Loading…</li>' : logins.map((l) => `<li><span class="is-who"><b>${esc(l.name)}</b><small>${esc(l.email)} · ${l.role === 'barber' ? `barber at ${esc(shopName(l.shop))}, ${chairOf(l)}` : 'front desk'}</small></span><button type="button" class="u-btn u-btn--sm" data-remove-login="${l.uid}" aria-label="Remove the login for ${esc(l.name)}">Remove</button></li>`).join('') || '<li class="u-empty">No staff logins yet. The only login is yours.</li>');
    if (document.activeElement !== loginFor) {
      const keep = loginFor.value;
      fill(loginFor, '<option value="">For the shop tablet (front desk)</option>' + shops.map((sh) => Object.entries(desk.board(sh.id, now).staff).sort((x, y) => x[1].chair - y[1].chair)
        .map(([id, x]) => `<option value="${sh.id}/${id}">For ${esc(sh.name)}, chair ${x.chair}${x.name ? `, ${esc(x.name)}` : ''}</option>`).join('')).join(''));
      loginFor.value = [...loginFor.options].some((o) => o.value === keep) ? keep : '';
    }
  };

  // ---------- actions ----------
  const seat = (id: string) => {
    const free = boardView(desk.board(tab), Date.now()).chairs.find((c) => c.state === 'free');
    if (!free) { toast('No chair is free. Finish a cut first.'); return; }
    desk.act(tab, (b, now) => callNext(b, free.id, now, id));
  };
  // The extra actions behind a "more" button.
  const more = (ref: string) => {
    const [kind, id] = ref.split(':');
    const b = desk.board(tab);
    if (kind === 'chair') {
      const s = b.staff[id];
      if (!s) return;
      const cur = Object.entries(b.t).find(([, k]) => k.s === 'chair' && k.b === id);
      openSheet(`${barberLabel(s)} · Chair ${s.chair}`, cur
        ? [{ label: `Undo the call for number ${cur[1].n}`, attr: `data-uncall="${cur[0]}"` }]
        : [...(s.brk ? [] : [{ label: 'Take a break', attr: `data-brk-on="${id}"` }]), { label: 'End the shift for today', attr: `data-off="${id}"` }]);
    } else {
      const k = b.t[id];
      if (!k) return;
      openSheet(`Number ${k.n}${desk.name(tab, id) ? ` · ${desk.name(tab, id)}` : ''}`, [
        ...(k.s === 'way' ? [{ label: 'Seat now (they are here)', attr: `data-seat="${id}"` }] : []),
        ...(desk.email() && k.src !== 'desk' ? [{ label: 'Show their mobile number', attr: `data-contact="${id}"` }] : []),
        { label: 'Remove from the queue', attr: `data-remove="${id}"`, danger: true },
      ]);
    }
  };
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLElement>('[data-view-link]');
    if (link) { e.preventDefault(); showView(link.dataset.viewLink!); return; }
    if (e.target === sheet) { sheet.close(); return; }
    const t = (e.target as HTMLElement).closest<HTMLElement>('button');
    if (!t) return;
    const d = t.dataset;
    if (t.closest('[data-sheet]')) sheet.close();
    if (d.tab) { tab = d.tab; draw(); }
    else if (d.more) more(d.more);
    else if (d.call) desk.act(tab, (b, now) => callNext(b, d.call!, now));
    else if (d.finish) finishAndPay(desk, tab, d.finish, services, toast);
    else if (d.uncall) desk.act(tab, (b, now) => uncall(b, d.uncall!, now));
    // To ring a customer who is in the queue. Looked up one at a time, only when asked for.
    else if (d.contact) customerContact(d.contact).then((c) => (c?.mobile ? toast(`${c.name}: ${c.mobile}`, { label: 'Call', run: () => { location.href = `tel:${c.mobile}`; } }) : toast('No mobile number is held for this customer.')), () => toast('Could not get the number. Check the connection and try again.'));
    else if (d.brkOn) desk.act(tab, (b, now) => setBarber(b, d.brkOn!, { brk: true }, now));
    else if (d.brkOff) desk.act(tab, (b, now) => setBarber(b, d.brkOff!, { brk: false }, now));
    else if (d.off) desk.act(tab, (b, now) => setBarber(b, d.off!, { on: false }, now));
    else if (d.arrived) desk.act(tab, (b, now) => arrive(b, d.arrived!, now));
    else if (d.seat) seat(d.seat);
    else if (d.remove) desk.act(tab, (b, now) => removeTicket(b, d.remove!, now));
    else if (d.avg) desk.act(tab, (b, now) => setOptions(b, { avg: b.avg + Number(d.avg) }, now));
    else if ('open' in d) desk.act(tab, (b) => b);
    else if ('addBarber' in d) desk.act(tab, (b, now) => setBarber(b, newId('b'), {}, now));
    else if (d.dropBarber) { if (confirm('Remove this barber from the shop’s list?')) desk.act(tab, (b, now) => dropBarber(b, d.dropBarber!, now)); }
    else if (d.example) { if (confirm(`Replace the demo queue for ${shopName(tab)} with a “${d.example}” example?`)) desk.act(tab, (b, now) => ({ ...exampleBoard(d.example!, now, b), updatedAt: Math.max(now, b.updatedAt + 1) })); }
    else if ('clear' in d) { if (confirm(`Remove everyone from the queue for ${shopName(tab)}? This cannot be undone.`)) desk.act(tab, (b, now) => clearQueue(b, now)); }
    else if (d.removeLogin) { if (confirm('Remove this staff login? That person will no longer be able to run the queue or record payments.')) cloud.removeStaffLogin(d.removeLogin).then(reloadLogins).catch(() => toast('Could not remove the login. Try again.')); }
    else if ('out' in d) desk.signOut();
  });
  $<HTMLFormElement>('[data-new-login]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const f = new FormData(form);
    const [shop = '', b = ''] = String(f.get('for') ?? '').split('/');
    const say = (t: string) => { loginMsg.textContent = t; loginMsg.hidden = !t; };
    say('Creating the login…');
    try {
      const made = await cloud.createStaffLogin({ email: String(f.get('email')).trim(), password: String(f.get('password')), name: String(f.get('name')).trim(), shop, b });
      form.reset();
      say(`Login created for ${made.name}. They sign in on the barber panel with that email and password.`);
      reloadLogins();
    } catch (err) {
      const code = String((err as { code?: string }).code ?? '');
      say(code === 'own-login' ? 'That is your own login. Use a different email for staff.'
        : /wrong-password|invalid-credential|invalid-login/.test(code) ? 'That email already has a login with a different password. Type its current password to link it, or use another email.'
        : /weak-password/.test(code) ? 'Choose a longer password (8 or more characters).'
        : /invalid-email/.test(code) ? 'That email address does not look right.'
        : cloud.denied(err) ? 'Only the owner’s login can add staff logins.'
        : 'Could not create the login. Check the internet connection and try again.');
    }
  });
  $<HTMLFormElement>('[data-add]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = (e.target as HTMLFormElement).querySelector<HTMLInputElement>('input')!;
    const name = input.value.trim().replace(/\s+/g, ' ').slice(0, 24);
    const id = newId('w');
    input.value = ''; // cleared at once, so the next name can be typed while this one saves
    if (!(await desk.act(tab, (b, now) => addWalkIn(b, id, now)))) { input.value ||= name; return; }
    if (name) desk.setName(tab, id, name);
    toast(`Number ${desk.board(tab).t[id]?.n ?? ''}${name ? ` for ${name}` : ''}: added to the queue`);
  });
  staffEl.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    const id = el.closest<HTMLElement>('[data-barber]')?.dataset.barber;
    if (!id || !el.dataset.f) return;
    const patch = el.dataset.f === 'on' ? { on: el.checked } : el.dataset.f === 'chair' ? { chair: Number(el.value) } : { name: el.value };
    const shop = tab;
    el.blur();
    desk.act(shop, (b, now) => setBarber(b, id, patch, now));
  });
  // The chosen value is read before saving: the screen redraws while a save is in progress.
  modeEl.addEventListener('change', () => { const mode = modeEl.value as LiveMode; desk.act(tab, (b, now) => setOptions(b, { mode }, now)); });
  onlineEl.addEventListener('change', () => { const online = onlineEl.value === 'on'; desk.act(tab, (b, now) => setOptions(b, { online }, now)); });
  let noteTimer: number | undefined;
  // The text and the shop are taken at the moment of typing: the screen may redraw before the save.
  noteEl.addEventListener('input', () => { const note = noteEl.value, shop = tab; clearTimeout(noteTimer); noteTimer = window.setTimeout(() => desk.act(shop, (b, now) => setOptions(b, { note }, now)), 500); });
  $('[data-sheet-close]').addEventListener('click', () => sheet.close());

  wireSignIn(account, { formId: 'qd-signin' });

  // ---------- start ----------
  draw();
  setInterval(() => {
    const now = Date.now();
    // Drop online places whose owner never arrived, then refresh the countdowns.
    for (const s of shops) if (Object.values(desk.board(s.id, now).t).some((k) => lapsed(k, now))) desk.act(s.id, (b) => b);
    draw();
  }, 15_000);
</script>
