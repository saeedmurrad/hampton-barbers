---
// The queue desk: the shop's own screen for running the queue. Add walk-ins, mark online
// customers as arrived, call people to a chair, finish cuts, and manage barbers and settings.
import '../../styles/staff.css';
import Base from '../../layouts/Base.astro';
import { shops, menu } from '../../data/site';
import { penceOf } from '../../lib/sales';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const services = menu.flatMap((c) => c.items.map((i) => ({ name: i.name, price: penceOf(i.price) })));
---
<Base noindex title="Hampton Barbers: queue desk" description="Run the walk-in queue: add walk-ins, call customers to a chair and keep the shop screen up to date.">
  <main id="main" class="qd" data-base={base} data-services={JSON.stringify(services)}>
    <header class="qd__top">
      <div>
        <p class="qd__back"><a href={`${base}/admin/`}>← Prices and hours</a><a href={`${base}/admin/reports/`}>Takings and reports →</a></p>
        <h1>Queue desk</h1>
      </div>
      <p id="qd-status" role="status" aria-live="polite">Loading…</p>
    </header>

    <section class="qd__acct" id="qd-account" aria-label="Your account"></section>

    <nav class="qd__tabs" aria-label="Which shop">
      {shops.map((s, i) => <button type="button" data-tab={s.id} aria-pressed={i === 0 ? 'true' : 'false'}><span>{s.name}</span></button>)}
    </nav>
    <p class="qd__links" data-links></p>
    <p class="qd__banner" data-banner hidden></p>

    <div class="qd__grid">
      <section class="qd__card" aria-labelledby="qd-h-chairs">
        <div class="qd__head"><h2 id="qd-h-chairs">Chairs</h2><p data-summary></p></div>
        <ul class="qd__chairs" data-chairs></ul>
      </section>

      <section class="qd__card" aria-labelledby="qd-h-line">
        <div class="qd__head"><h2 id="qd-h-line">Waiting, in number order</h2><p>People who join on their phones appear here by themselves.</p></div>
        <form class="qd__add" data-add>
          <input name="name" maxlength="24" autocomplete="off" placeholder="First name (optional)" aria-label="Walk-in’s first name (optional)" />
          <button type="submit" class="primary">+ Add walk-in</button>
        </form>
        <ol class="qd__line" data-queue></ol>
      </section>
    </div>

    <details class="qd__card qd__more">
      <summary>Barbers and settings</summary>
      <div class="qd__set">
        <div>
          <h3>Barbers at this shop</h3>
          <p class="qd__hint">Each barber has their own profile and chair. Customers are assigned to a barber when they are called.</p>
          <ul class="qd__staff" data-staff></ul>
          <button type="button" data-add-barber>+ Add a barber</button>
        </div>
        <div class="qd__opts">
          <h3>Queue settings</h3>
          <div class="qd__step">
            <div><b>Usual minutes per cut</b><small>Used for the wait estimates. Timed cuts fine-tune it through the day.</small></div>
            <div class="qd__ctl"><button type="button" data-avg="-5" aria-label="Fewer minutes per cut">−</button><output data-avg-val>20</output><button type="button" data-avg="5" aria-label="More minutes per cut">+</button></div>
          </div>
          <label class="qd__field">Joining from a phone
            <select id="qd-online">
              <option value="on">On: customers can join from their phones</option>
              <option value="off">Paused: walk-ins only</option>
            </select>
          </label>
          <label class="qd__field">How busy we look
            <select id="qd-mode">
              <option value="auto">Work it out from the queue (recommended)</option>
              <option value="quiet">Quiet: walk straight in</option>
              <option value="steady">Short wait</option>
              <option value="busy">Busy</option>
              <option value="very-busy">Very busy</option>
              <option value="paused">Not cutting right now (break or closing)</option>
            </select>
          </label>
          <label class="qd__field">Short message for customers (optional)
            <input id="qd-note" maxlength="120" placeholder="e.g. Back from lunch at 2pm" />
          </label>
          <div class="qd__row" data-demo-only>
            <span>Fill the queue with an example:</span>
            <button type="button" data-example="quiet">Quiet</button>
            <button type="button" data-example="steady">Steady</button>
            <button type="button" data-example="busy">Busy</button>
          </div>
          <div class="qd__row"><button type="button" data-clear>Clear the queue</button><small>Removes everyone waiting and in the chairs. Ticket numbers carry on.</small></div>
        </div>
      </div>
    </details>
  </main>
</Base>

<script>
  import { addWalkIn, arrive, boardView, callNext, clearQueue, clockText, dropBarber, exampleBoard, lapsed, minsText, removeTicket, setBarber, setOptions, uncall, type LiveMode } from '../../lib/board';
  import { createDesk } from '../../lib/desk';
  import { finishAndPay, loadServices, type Service } from '../../lib/paysheet';
  import { esc, newId } from '../../lib/store';

  const root = document.querySelector<HTMLElement>('.qd')!;
  let services = JSON.parse(root.dataset.services || '[]') as Service[];
  loadServices(services).then((list) => { services = list; });
  const base = root.dataset.base ?? '';
  const emu = new URLSearchParams(location.search).has('emulator');
  const tabs = [...document.querySelectorAll<HTMLElement>('[data-tab]')];
  const shops = tabs.map((b) => ({ id: b.dataset.tab!, name: b.textContent!.trim() }));
  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const statusEl = $('#qd-status'), account = $('#qd-account'), linksEl = $('[data-links]'), bannerEl = $('[data-banner]');
  const chairsEl = $('[data-chairs]'), queueEl = $('[data-queue]'), staffEl = $('[data-staff]'), summaryEl = $('[data-summary]');
  const modeEl = $<HTMLSelectElement>('#qd-mode'), onlineEl = $<HTMLSelectElement>('#qd-online'), noteEl = $<HTMLInputElement>('#qd-note');
  const fill = (el: HTMLElement, html: string) => { if (el.dataset.html !== html) { el.innerHTML = html; el.dataset.html = html; } };
  const shopName = (id: string) => shops.find((s) => s.id === id)?.name ?? 'the shop';

  let tab = shops.find((s) => s.id === new URLSearchParams(location.search).get('shop'))?.id ?? shops[0].id;
  let accountMsg = '';
  let drawnFor: string | null | undefined;
  const known: Record<string, Set<string>> = {}; // tickets already seen, so new online joiners can be announced

  const toast = (msg: string, action?: { label: string; run: () => void }) => {
    document.querySelector('.staff-toast')?.remove();
    const t = Object.assign(document.createElement('p'), { className: 'staff-toast' });
    t.setAttribute('role', 'status');
    t.append(msg);
    if (action) {
      const b = Object.assign(document.createElement('button'), { type: 'button', textContent: action.label });
      b.addEventListener('click', () => { t.remove(); action.run(); });
      t.append(b);
    }
    document.body.append(t);
    setTimeout(() => t.remove(), action ? 12_000 : 4500);
  };

  const desk = createDesk(shops.map((s) => s.id), () => draw());

  // ---------- drawing ----------
  const drawAccount = () => {
    const email = desk.email();
    if (drawnFor === email && !accountMsg) return;
    drawnFor = email;
    const note = accountMsg ? `<p class="qd__msg" role="alert">${esc(accountMsg)}</p>` : '';
    accountMsg = '';
    if (!desk.connected) { account.innerHTML = '<p><strong>Not connected.</strong> Changes show on this device only.</p>'; return; }
    account.innerHTML = email
      ? `<p>Signed in as <strong>${esc(email)}</strong>. Every change goes live straight away on the website, the barbers’ phones and the shop TV. <button type="button" class="link" data-out>Sign out</button></p>${note}`
      : `<form id="qd-signin" class="qd__signin"><b>Sign in to run the real queue</b>
          <input type="email" name="email" autocomplete="username" placeholder="Email" required />
          <input type="password" name="password" autocomplete="current-password" placeholder="Password" required />
          <button type="submit" class="primary">Sign in</button></form>${note}
        <p class="qd__hint">Until you sign in this is a demo that stays on this device: open the shop TV, a barber panel and a customer page in other tabs and they all follow along.</p>`;
  };

  const draw = () => {
    const now = Date.now();
    const b = desk.board(tab, now);
    const v = boardView(b, now);
    const signedIn = Boolean(desk.email());
    statusEl.textContent = desk.offline(tab) ? 'No connection. Showing the last known queue.' : desk.status();
    drawAccount();

    // Announce people who joined on their phones since the last look.
    for (const s of shops) {
      const ids = Object.entries(desk.board(s.id, now).t);
      if (known[s.id]) for (const [id, k] of ids) if (!known[s.id].has(id) && k.src !== 'desk' && now - k.at < 30_000) toast(`Number ${k.n} joined ${k.src === 'qr' ? 'at the door' : 'online'} for ${s.name}`);
      known[s.id] = new Set(ids.map(([id]) => id));
    }
    tabs.forEach((btn) => {
      const id = btn.dataset.tab!;
      btn.setAttribute('aria-pressed', String(id === tab));
      const n = boardView(desk.board(id, now), now).waiting;
      const badge = btn.querySelector('.badge');
      if (String(n || '') !== (badge?.textContent ?? '')) { badge?.remove(); if (n) btn.insertAdjacentHTML('beforeend', `<b class="badge" title="People waiting">${n}</b>`); }
    });
    const q = emu ? '?emulator' : '';
    fill(linksEl, `Open for ${esc(shopName(tab))}:
      <a href="${base}/board/${tab}/${q}" target="_blank" rel="noopener">Shop TV</a>
      <a href="${base}/barber/?shop=${tab}${emu ? '&emulator' : ''}" target="_blank" rel="noopener">Barber panel</a>
      <a href="${base}/queue/${tab}/${q}" target="_blank" rel="noopener">Customer page</a>
      <a href="${base}/queue/${tab}/?here=1${emu ? '&emulator' : ''}" target="_blank" rel="noopener">Door code link</a>
      <a href="${base}/poster/${tab}/" target="_blank" rel="noopener">Door poster</a>`);
    const closed = signedIn && !desk.opened(tab);
    bannerEl.hidden = !closed;
    if (closed) fill(bannerEl, `Today’s queue for ${esc(shopName(tab))} is not open yet, so customers cannot see or join it. <button type="button" class="primary" data-open>Open today’s queue</button>`);
    summaryEl.textContent = `${v.inShop} in the shop · ${v.onWay} on the way · walk-in wait: ${v.headline === 'No wait' ? 'none' : `${v.headline} ${v.unit}`.trim()}`;

    const next = v.line.find((x) => x.s === 'here');
    fill(chairsEl, v.chairs.map((c) => {
      const who = `Chair ${c.chair}${c.name ? ` · ${esc(c.name)}` : ''}`;
      if (c.state === 'busy') {
        const nm = desk.name(tab, c.tid!);
        return `<li class="busy${c.calling ? ' calling' : ''}"><div><small>${who}</small><b>${c.n}</b><span>${nm ? `${esc(nm)} · ` : ''}${c.calling ? 'called just now' : `${c.mins} min so far`}</span></div>
          <div class="qd__btns"><button type="button" class="primary" data-finish="${c.id}">Finish</button><button type="button" data-uncall="${c.tid}">Undo</button></div></li>`;
      }
      if (c.state === 'break') return `<li class="break"><div><small>${who}</small><b>Break</b><span>Not taking customers</span></div>
        <div class="qd__btns"><button type="button" data-brk-off="${c.id}">Back from break</button></div></li>`;
      return `<li class="free"><div><small>${who}</small><b>Free</b><span>${next ? `Next is number ${next.n}` : v.onWay ? 'Nobody in the shop yet' : 'Nobody waiting'}</span></div>
        <div class="qd__btns"><button type="button" class="primary" data-call="${c.id}">Call next</button><button type="button" data-brk-on="${c.id}">Break</button></div></li>`;
    }).join('') || '<li class="none">No barbers are on shift. Open “Barbers and settings” below to put someone on shift.</li>');

    fill(queueEl, v.line.map((x) => {
      const k = b.t[x.id];
      const nm = desk.name(tab, x.id);
      const title = nm ? esc(nm) : k.src === 'desk' ? 'Walk-in' : 'Online customer';
      const sub = x.s === 'here' ? `In the shop${k.src === 'desk' ? '' : ' · joined on their phone'}` : `On the way · due ${clockText(x.due)}${k.late ? ' · running late' : ''}`;
      return `<li class="${x.s}"><span class="n">${x.n}</span><span class="who"><b>${title}</b><small>${sub}</small></span><span class="eta">${minsText(x.mins)}</span>
        <span class="qd__btns">${x.s === 'way' ? `<button type="button" data-arrived="${x.id}">Arrived</button>` : ''}<button type="button" class="primary" data-seat="${x.id}">Seat</button><button type="button" data-remove="${x.id}" aria-label="Remove number ${x.n} from the queue">Remove</button></span></li>`;
    }).join('') || '<li class="empty">Nobody waiting</li>');

    if (!staffEl.contains(document.activeElement)) {
      fill(staffEl, Object.entries(b.staff).sort((x, y) => x[1].chair - y[1].chair).map(([id, s]) => `<li data-barber="${id}">
        <label class="num">Chair<input type="number" min="1" max="30" value="${s.chair}" data-f="chair" /></label>
        <label class="grow">Name<input maxlength="20" value="${esc(s.name)}" placeholder="First name" data-f="name" /></label>
        <label class="chk"><input type="checkbox" ${s.on ? 'checked' : ''} data-f="on" />On shift</label>
        <span class="done">${s.done} cut${s.done === 1 ? '' : 's'} today</span>
        <button type="button" data-drop-barber="${id}" aria-label="Remove ${esc(s.name || `the barber on chair ${s.chair}`)}">Remove</button></li>`).join('') || '<li class="none">No barbers yet.</li>');
    }
    $('[data-avg-val]').textContent = String(b.avg);
    modeEl.value = b.mode;
    onlineEl.value = b.online ? 'on' : 'off';
    if (document.activeElement !== noteEl) noteEl.value = b.note;
    $('[data-demo-only]').hidden = signedIn;
  };

  // ---------- actions ----------
  const seat = (id: string) => {
    const free = boardView(desk.board(tab), Date.now()).chairs.find((c) => c.state === 'free');
    if (!free) { toast('No chair is free. Finish a cut first.'); return; }
    desk.act(tab, (b, now) => callNext(b, free.id, now, id));
  };
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('button');
    if (!t) return;
    const d = t.dataset;
    if (d.tab) { tab = d.tab; draw(); }
    else if (d.call) desk.act(tab, (b, now) => callNext(b, d.call!, now));
    else if (d.finish) finishAndPay(desk, tab, d.finish, services, toast);
    else if (d.uncall) desk.act(tab, (b, now) => uncall(b, d.uncall!, now));
    else if (d.brkOn) desk.act(tab, (b, now) => setBarber(b, d.brkOn!, { brk: true }, now));
    else if (d.brkOff) desk.act(tab, (b, now) => setBarber(b, d.brkOff!, { brk: false }, now));
    else if (d.arrived) desk.act(tab, (b, now) => arrive(b, d.arrived!, now));
    else if (d.seat) seat(d.seat);
    else if (d.remove) desk.act(tab, (b, now) => removeTicket(b, d.remove!, now));
    else if (d.avg) desk.act(tab, (b, now) => setOptions(b, { avg: b.avg + Number(d.avg) }, now));
    else if ('open' in d) desk.act(tab, (b) => b);
    else if ('addBarber' in d) desk.act(tab, (b, now) => setBarber(b, newId('b'), {}, now));
    else if (d.dropBarber) { if (confirm('Remove this barber from the shop’s list?')) desk.act(tab, (b, now) => dropBarber(b, d.dropBarber!, now)); }
    else if (d.example) { if (confirm(`Replace the demo queue for ${shopName(tab)} with a “${d.example}” example?`)) desk.act(tab, (b, now) => ({ ...exampleBoard(d.example!, now, b), updatedAt: Math.max(now, b.updatedAt + 1) })); }
    else if ('clear' in d) { if (confirm(`Remove everyone from the queue for ${shopName(tab)}? This cannot be undone.`)) desk.act(tab, (b, now) => clearQueue(b, now)); }
    else if ('out' in d) desk.signOut();
  });
  $<HTMLFormElement>('[data-add]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const input = (e.target as HTMLFormElement).querySelector<HTMLInputElement>('input')!;
    const name = input.value.trim().replace(/\s+/g, ' ').slice(0, 24);
    const id = newId('w');
    input.value = ''; // cleared at once, so the next name can be typed while this one saves
    if (!(await desk.act(tab, (b, now) => addWalkIn(b, id, now)))) { input.value ||= name; return; }
    if (name) desk.setName(tab, id, name);
    toast(`Number ${desk.board(tab).t[id]?.n ?? ''}${name ? ` for ${name}` : ''}: added to the queue`);
  });
  staffEl.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    const id = el.closest<HTMLElement>('[data-barber]')?.dataset.barber;
    if (!id || !el.dataset.f) return;
    const patch = el.dataset.f === 'on' ? { on: el.checked } : el.dataset.f === 'chair' ? { chair: Number(el.value) } : { name: el.value };
    const shop = tab;
    el.blur();
    desk.act(shop, (b, now) => setBarber(b, id, patch, now));
  });
  // The chosen value is read before saving: the screen redraws while a save is in progress.
  modeEl.addEventListener('change', () => { const mode = modeEl.value as LiveMode; desk.act(tab, (b, now) => setOptions(b, { mode }, now)); });
  onlineEl.addEventListener('change', () => { const online = onlineEl.value === 'on'; desk.act(tab, (b, now) => setOptions(b, { online }, now)); });
  let noteTimer: number | undefined;
  noteEl.addEventListener('input', () => { clearTimeout(noteTimer); noteTimer = window.setTimeout(() => { const note = noteEl.value; desk.act(tab, (b, now) => setOptions(b, { note }, now)); }, 500); });

  account.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = new FormData(e.target as HTMLFormElement);
    try { await desk.signIn(String(f.get('email')).trim(), String(f.get('password'))); }
    catch { accountMsg = 'The email or password is not right.'; draw(); }
  });

  // ---------- start ----------
  draw();
  setInterval(() => {
    const now = Date.now();
    // Drop online places whose owner never arrived, then refresh the countdowns.
    for (const s of shops) if (Object.values(desk.board(s.id, now).t).some((k) => lapsed(k, now))) desk.act(s.id, (b) => b);
    draw();
  }, 15_000);
</script>

<style is:global>
  .qd { --bg: #f4f2ee; --surface: #fff; --text: #15140f; --muted: #57534a; --accent: #15140f; --on-accent: #fff; --line: #d9d4c8; --ok: #1f8a4c; --warn: #b4690e; --display: 'Bricolage Grotesque Variable', system-ui, sans-serif; background: #f4f2ee; color: #15140f; min-height: 100svh; padding: clamp(1rem, 3vw, 2.5rem) clamp(1rem, 4vw, 3rem) 5rem; }
  .qd > * { max-width: 76rem; margin-inline: auto; }
  .qd__top { display: flex; justify-content: space-between; align-items: end; gap: .5rem 1rem; flex-wrap: wrap; position: sticky; top: 0; z-index: 5; background: #f4f2ee; padding-block: .75rem; border-bottom: 1px solid var(--line); }
  .qd__back { display: flex; flex-wrap: wrap; gap: .2rem 1.2rem; font-size: .9rem; color: var(--muted); }
  .qd h1 { font-family: var(--display); font-weight: 800; font-size: clamp(1.8rem, 5vw, 2.8rem); letter-spacing: -.04em; margin-top: .3rem; }
  .qd h2 { font-family: var(--display); font-weight: 750; font-size: 1.35rem; letter-spacing: -.02em; }
  .qd h3 { font-family: inherit; font-size: .78rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: .6rem; }
  #qd-status { font-weight: 700; font-size: .92rem; color: var(--ok); }
  .qd button, .qd input, .qd select { font: inherit; }
  .qd button { min-height: 2.9rem; padding: .5rem 1rem; border: 1px solid var(--line); border-radius: 10px; background: #fff; color: inherit; font-weight: 650; cursor: pointer; }
  .qd button:hover { border-color: #15140f; }
  .qd .primary { background: #15140f; color: #fff; border-color: #15140f; }
  .qd .link { border: 0; background: none; text-decoration: underline; min-height: auto; padding: 0 .25rem; }
  .qd input:not([type='checkbox']), .qd select { min-height: 2.9rem; padding: .5rem .75rem; border: 1px solid var(--line); border-radius: 10px; background: #fff; color: inherit; min-width: 0; }
  .qd__acct { margin-top: 1rem; padding: 1rem 1.1rem; background: #fff; border: 1px solid var(--line); border-radius: 14px; }
  .qd__signin { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
  .qd__signin b { width: 100%; }
  .qd__signin input { flex: 1 1 12rem; }
  .qd__hint { font-size: .85rem; color: var(--muted); margin-top: .5rem; }
  .qd__msg { color: #8a4b00; font-weight: 600; margin-top: .5rem; }
  .qd__tabs { display: flex; flex-wrap: wrap; gap: .4rem; margin-block: 1.25rem .6rem; }
  .qd__tabs button[aria-pressed='true'] { background: #15140f; color: #fff; border-color: #15140f; }
  .qd__tabs b.badge { display: inline-grid; place-items: center; min-width: 1.35rem; height: 1.35rem; margin-left: .4rem; padding-inline: .3rem; border-radius: 999px; background: #e4472b; color: #fff; font-size: .72rem; }
  .qd__links { display: flex; flex-wrap: wrap; align-items: center; gap: .3rem .9rem; font-size: .9rem; color: var(--muted); margin-bottom: 1rem; }
  .qd__links a { font-weight: 650; color: #15140f; }
  .qd__banner { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; padding: .8rem 1rem; margin-bottom: 1rem; border-radius: 14px; background: #fff3d6; border: 1px solid #e8c36a; font-weight: 600; }
  .qd__banner[hidden] { display: none; }
  .qd__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 1.25rem; align-items: start; }
  .qd__card { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 1.1rem 1.2rem 1.25rem; }
  .qd__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .2rem 1rem; margin-bottom: .9rem; }
  .qd__head p { font-size: .82rem; color: var(--muted); }
  .qd__btns { display: flex; flex-wrap: wrap; gap: .4rem; }
  .qd__chairs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 12.5rem), 1fr)); gap: .7rem; }
  .qd__chairs li { display: grid; gap: .8rem; align-content: space-between; padding: .9rem 1rem 1rem; border-radius: 14px; background: #f7f4ee; border: 1.5px solid transparent; }
  .qd__chairs li > div:first-child { display: grid; gap: .1rem; }
  .qd__chairs small { font-size: .78rem; font-weight: 700; color: var(--muted); }
  .qd__chairs b { font-family: var(--display); font-weight: 800; font-size: 2.6rem; line-height: 1; letter-spacing: -.03em; }
