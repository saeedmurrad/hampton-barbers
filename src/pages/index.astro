---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Fresh from '../components/Fresh.astro';
import { designs } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/previews/*.jpg', { eager: true });
const shot = (id: string) => shots[`../assets/previews/${id}.jpg`]?.default;
---
{import.meta.env.PUBLIC_DEMO === 'false' ? <Fresh /> : <Base title="Hampton Barbers: four website designs" description="Four different website designs for Hampton Barbers, Peterborough.">
  <main id="main" class="pick">
    <header>
      <h1>Hampton Barbers</h1>
      <p>Four website designs. Each one is a different layout, not a recolour. Open any of them to see the full page.</p>
    </header>
    <ol>
      {designs.map((d, i) => (
        <li>
          <a href={`${base}/${d.id}/`}>
            {shot(d.id) && <Image src={shot(d.id)!} alt={`Preview of the ${d.name} design`} widths={[520, 900]} sizes="(max-width: 800px) 100vw, 45vw" />}
            <div><span>Design {i + 1}</span><h2>{d.name}</h2><p>{d.blurb}</p></div>
          </a>
        </li>
      ))}
    </ol>
    <h2 class="pick__sub">The queue system</h2>
    <div class="pick__tools">
      <a class="pick__admin" href={`${base}/admin/live/`}><strong>Queue desk</strong><span>The shop's screen: add walk-ins, call customers to a chair, manage barbers.</span></a>
      <a class="pick__admin" href={`${base}/barber/`}><strong>Barber panel</strong><span>Each barber's own phone screen: who is next, call, finish, breaks.</span></a>
      <a class="pick__admin" href={`${base}/board/hampton-vale/`}><strong>Shop TV</strong><span>Ticket numbers, chairs and waits. Open it on the TV in the shop.</span></a>
      <a class="pick__admin" href={`${base}/admin/reports/`}><strong>Takings and reports</strong><span>The owner's figures by day, week and month: each barber, cash and online, and the percentage split.</span></a>
      <a class="pick__admin" href={`${base}/queue/hampton-vale/`}><strong>Customer queue page</strong><span>What a customer sees after scanning the code on the door.</span></a>
    </div>
    <a class="pick__admin" href={`${base}/admin/`}><strong>Admin page</strong><span>Change prices, add services and add categories. The four designs update to match.</span></a>
  </main>
</Base>}

<style is:global>
  .pick { --bg: #f4f2ee; --text: #15140f; --accent: #15140f; background: #f4f2ee; color: #15140f; min-height: 100svh; padding: clamp(2rem, 6vw, 5rem) clamp(1.25rem, 5vw, 5rem) 5rem; font-family: 'Inter Variable', system-ui, sans-serif; }
  .pick header { max-width: 44rem; margin-bottom: clamp(2rem, 5vw, 4rem); }
  .pick h1 { font-family: 'Bricolage Grotesque Variable', system-ui, sans-serif; font-weight: 800; font-size: clamp(2.6rem, 7vw, 5rem); letter-spacing: -.04em; }
  .pick header p { font-size: 1.15rem; color: #57534a; margin-top: 1rem; }
  .pick ol { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(1.25rem, 3vw, 2.5rem); }
  .pick li a { display: block; text-decoration: none; background: #fff; border: 1px solid #ddd8cd; border-radius: 16px; overflow: hidden; transition: transform .35s cubic-bezier(.2,.8,.2,1), box-shadow .35s; }
  .pick li a:hover { transform: translateY(-6px); box-shadow: 0 24px 50px rgb(0 0 0 / .14); }
  .pick img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; border-bottom: 1px solid #ddd8cd; }
  .pick li div { padding: 1.4rem 1.6rem 1.7rem; }
  .pick span { font-size: .78rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #8a8477; }
  .pick h2 { font-family: 'Bricolage Grotesque Variable', system-ui, sans-serif; font-weight: 700; font-size: 1.9rem; letter-spacing: -.03em; margin-top: .3rem; }
  .pick li p { color: #57534a; margin-top: .5rem; }
  .pick__admin { display: grid; gap: .3rem; margin-top: clamp(1.25rem, 3vw, 2.5rem); padding: 1.4rem 1.6rem; border-radius: 16px; background: #15140f; color: #fff; text-decoration: none; }
  .pick__admin strong { font-family: 'Bricolage Grotesque Variable', system-ui, sans-serif; font-size: 1.5rem; letter-spacing: -.02em; }
  .pick__admin span { color: #c9c4b8; font-size: 1rem; font-weight: 400; letter-spacing: 0; text-transform: none; }
  .pick__sub { margin-top: clamp(2rem, 5vw, 3.5rem); font-size: 1.9rem; }
  .pick__tools { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 clamp(1.25rem, 3vw, 2.5rem); }
  @media (max-width: 800px) { .pick ol, .pick__tools { grid-template-columns: 1fr; } }
</style>
