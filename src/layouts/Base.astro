---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/playfair-display/wght.css';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource/bebas-neue/index.css';
import '../styles/global.css';
import { site, designs } from '../data/site';

interface Props { title: string; description?: string; design?: string; themeColor?: string; }
const { title, description = site.description, design, themeColor = '#12100e' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isDemo = import.meta.env.PUBLIC_DEMO !== 'false';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const n = designs.findIndex((d) => d.id === design);
const prev = designs[(n + designs.length - 1) % designs.length];
const next = designs[(n + 1) % designs.length];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: site.name,
  description: site.description,
  url: canonical,
  telephone: '+441733247848',
  priceRange: '£',
  foundingDate: String(site.since),
  address: { '@type': 'PostalAddress', streetAddress: site.address.street, addressLocality: `${site.address.locality}, ${site.address.city}`, postalCode: site.address.postcode, addressCountry: 'GB' },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: site.mapsUrl,
  areaServed: ['Hampton Vale', 'Hampton Hargate', 'Hampton', 'Peterborough'],
  sameAs: [site.facebook, site.instagram, site.mapsUrl],
  openingHoursSpecification: site.hours.map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: `https://schema.org/${h.label}`, opens: h.open, closes: h.close })),
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isDemo && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {design && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class={design} id="top">
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    {design && <div class="bar"><a href={site.phoneHref}>Call the shop</a><a href={site.directionsUrl} rel="noopener">Directions</a></div>}
    {isDemo && design && (
      <nav class="designs" aria-label="Design options">
        <a href={`${base}/${prev.id}/`} aria-label={`Previous design: ${prev.name}`}>‹</a>
        <span>Design {n + 1} of {designs.length}: {designs[n].name}</span>
        <a href={`${base}/${next.id}/`} aria-label={`Next design: ${next.name}`}>›</a>
        <a href={`${base}/`}>All</a>
        <a class="designs__admin" href={`${base}/admin/`}>Edit prices</a>
      </nav>
    )}
    <script>
      import { renderMenu, STORE_KEY, fetchLive } from '../lib/menu';

      // Price list: an unpublished draft on this device wins (so the admin can preview it),
      // otherwise the published list from Firebase replaces the built-in one.
      const priceHost = document.querySelector<HTMLElement>('[data-menu]');
      if (priceHost) {
        const show = (cats: unknown) => {
          const html = renderMenu(priceHost.dataset.menu!, cats as never);
          if (html && html !== priceHost.innerHTML) priceHost.innerHTML = html;
        };
        let draft: string | null = null;
        try { draft = localStorage.getItem(STORE_KEY); } catch { /* storage blocked */ }
        if (draft) {
          try {
            show(JSON.parse(draft));
            const note = document.createElement('p');
            note.className = 'draftnote';
            note.textContent = 'You are seeing your unpublished draft prices.';
            document.body.append(note);
          } catch { /* broken draft: keep the built-in list */ }
        } else {
          fetchLive().then((cats) => { if (cats) show(cats); });
        }
      }

      // Scroll reveals
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -6% 0px', threshold: 0.08 });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Open / closed status and today's row (shop time = Europe/London)
      const pills = document.querySelectorAll<HTMLElement>('[data-hours]');
      if (pills.length) {
        const hours: { day: number; open: string; close: string }[] = JSON.parse(pills[0].dataset.hours!);
        const parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date());
        const get = (t: string) => parts.find((p) => p.type === t)!.value;
        const day = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'].indexOf(get('weekday'));
        const now = `${get('hour')}:${get('minute')}`;
        const today = hours.find((h) => h.day === day)!;
        const next = hours.find((h) => h.day === (day + 1) % 7)!;
        const open = now >= today.open && now < today.close;
        const f = (t: string) => { const [h, m] = t.split(':').map(Number); return `${((h + 11) % 12) + 1}${m ? ':' + String(m).padStart(2, '0') : ''}${h < 12 ? 'am' : 'pm'}`; };
        const text = open ? `Open now, until ${f(today.close)}` : now < today.open ? `Closed, opens ${f(today.open)} today` : `Closed, opens ${f(next.open)} tomorrow`;
        pills.forEach((el) => { el.dataset.open = String(open); el.querySelector('span')!.textContent = text; });
        document.querySelectorAll(`[data-day="${day}"]`).forEach((el) => el.setAttribute('data-today', ''));
      }

    </script>
  </body>
</html>
