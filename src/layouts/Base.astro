---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/playfair-display/wght.css';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource/bebas-neue/index.css';
import '../styles/global.css';
import { site, designs } from '../data/site';

interface Props { title: string; description?: string; design?: string; themeColor?: string; }
const { title, description = site.description, design, themeColor = '#12100e' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isDemo = import.meta.env.PUBLIC_DEMO !== 'false';
const canonical = new URL(!isDemo && design ? `${base}/` : Astro.url.pathname, Astro.site).href;
const n = designs.findIndex((d) => d.id === design);
const prev = designs[(n + designs.length - 1) % designs.length];
const next = designs[(n + 1) % designs.length];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  name: site.name,
  description: site.description,
  url: canonical,
  telephone: '+441733247848',
  priceRange: '£',
  foundingDate: String(site.since),
  address: { '@type': 'PostalAddress', streetAddress: site.address.street, addressLocality: `${site.address.locality}, ${site.address.city}`, postalCode: site.address.postcode, addressCountry: 'GB' },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  hasMap: site.mapsUrl,
  areaServed: ['Hampton Vale', 'Hampton Hargate', 'Hampton', 'Peterborough'],
  sameAs: [site.facebook, site.instagram, site.mapsUrl],
  openingHoursSpecification: site.hours.map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: `https://schema.org/${h.label}`, opens: h.open, closes: h.close })),
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(isDemo || Astro.url.pathname.endsWith('/admin/') || Boolean(design && Astro.url.pathname !== `${base}/`)) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {design && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class={design} id="top">
    <a class="skip" href="#main">Skip to content</a>
    <slot />
    {design && (
      <nav class="fab" aria-label="Quick contact">
        <a class="fab__dir" href={site.directionsUrl} rel="noopener" aria-label="Get directions to the shop">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" /></svg>
        </a>
        <a class="fab__call" href={site.phoneHref} aria-label={`Call the shop on ${site.phone}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8Z" /></svg>
          <span>Call</span>
        </a>
      </nav>
    )}
    {isDemo && design && (
      <nav class="designs" aria-label="Design options">
        <a href={`${base}/${prev.id}/`} aria-label={`Previous design: ${prev.name}`}>‹</a>
        <span><i class="designs__long">Design </i>{n + 1}<i class="designs__long"> of {designs.length}</i><i class="designs__short">/{designs.length}</i>: {designs[n].name}</span>
        <a href={`${base}/${next.id}/`} aria-label={`Next design: ${next.name}`}>›</a>
        <a href={`${base}/`}>All</a>
        <a class="designs__admin" href={`${base}/admin/`}>Edit prices</a>
        <a class="designs__admin" href={`${base}/admin/live/`}>Set wait</a>
      </nav>
    )}
    <script>
      import { renderMenu, STORE_KEY, fetchLive } from '../lib/menu';

      import { parseVisit, renderVisit, VISIT_DRAFT_KEY } from '../lib/visit';

      const priceHost = document.querySelector<HTMLElement>('[data-menu]');
      if (priceHost) {
        let menuDraft: string | null = null;
        let visitDraft: string | null = null;
        let settings = parseVisit();
        try {
          menuDraft = localStorage.getItem(STORE_KEY);
          visitDraft = localStorage.getItem(VISIT_DRAFT_KEY);
        } catch { /* storage blocked */ }

        const showMenu = (menu: Parameters<typeof renderMenu>[1]) => {
          const html = renderMenu(priceHost.dataset.menu!, menu);
          if (html && html !== priceHost.innerHTML) {
            const expanded = priceHost.querySelector<HTMLDetailsElement>('details')?.open;
            priceHost.innerHTML = html;
            if (expanded) priceHost.querySelector('details')?.setAttribute('open', '');
          }
        };
        if (menuDraft) {
          try { showMenu(JSON.parse(menuDraft)); } catch { menuDraft = null; }
        }
        if (visitDraft) settings = parseVisit(visitDraft);
        if (menuDraft || visitDraft) {
          const note = document.createElement('p');
          note.className = 'draftnote';
          note.textContent = 'You are seeing an unpublished draft on this device.';
          document.body.append(note);
        }

        renderVisit(settings);
        fetchLive().then((live) => {
          if (!live) return;
          if (!menuDraft) showMenu(live.menu);
          if (!visitDraft) {
            settings = live.visit;
            renderVisit(settings);
          }
        });
        window.setInterval(() => renderVisit(settings), 30_000);
      }

      // Scroll reveals
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -6% 0px', threshold: 0 });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

    </script>
  </body>
</html>
