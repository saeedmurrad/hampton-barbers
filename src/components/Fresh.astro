---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Status from './Status.astro';
import Hours from './Hours.astro';
import SpecialHours from './SpecialHours.astro';
import Map from './Map.astro';
import { site, menu, styles } from '../data/site';
import ShopPhotos from './ShopPhotos.astro';
import LiveNow from './LiveNow.astro';
import LiveChip from './LiveChip.astro';
import Reviews from './Reviews.astro';
import { renderMenu } from '../lib/menu';
import shopfront from '../assets/photos/shopfront.jpg';
import shave from '../assets/photos/shave.jpg';
import cut1 from '../assets/photos/cut-1.jpg';
import cut2 from '../assets/photos/cut-2.jpg';
import cut3 from '../assets/photos/cut-3.png';
import cut4 from '../assets/photos/cut-4.jpg';
import cut5 from '../assets/photos/cut-5.jpg';
import '../styles/fresh.css';

const isDemo = import.meta.env.PUBLIC_DEMO !== 'false';
const address = `${site.address.street}, ${site.address.locality}, ${site.address.city} ${site.address.postcode}`;
const filters = ['All styles', 'Fades', 'Scissor cuts', 'Beards & shaves', 'Kids'];
const styleFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/styles/*.jpg', { eager: true });
const photos = await Promise.all(styles.map((st) => ({ src: styleFiles[`../assets/styles/${st.key}.jpg`].default, title: st.name, tags: st.tags, position: st.pos })).map(async (photo) => ({ ...photo, full: (await getImage({ src: photo.src, width: Math.min(photo.src.width, 1100), format: 'webp' })).src })));
const faq = [
  ['Do I need an appointment?', 'No. Hampton Barbers is a walk-in shop. Come in during opening hours and we’ll see you as soon as a chair is free.'],
  ['Do you cut children’s hair?', 'Yes. See the price list for children’s cuts and the Father & Son offer.'],
  ['Can I show my barber a photo?', 'Yes. Bring a reference photo or pick a style from our gallery and show it to your barber.'],
  ['Who can I ask about parking, access or payment?', 'Call the shop before your visit and we’ll help you plan it.'],
];
---
<Base title="Hampton Barbers | Walk-in barbers in Hampton Vale, Peterborough" design="fresh" themeColor="#14251d">
  <header class="fresh-nav">
    <div class="wrap fresh-nav__inner">
      <a href="#top" class="fresh-brand"><span aria-hidden="true">HB<span>.</span></span><strong>Hampton<br />Barbers</strong></a>
      <nav aria-label="Main"><a href="#prices">Services</a><a href="#cuts">Styles</a><a href="#find">Visit</a></nav>
      <a class="btn btn--line" href={site.phoneHref}>Call the shop</a>
    </div>
  </header>

  <main id="main">
    <section class="fresh-hero">
      <div class="wrap fresh-hero__grid">
        <div class="fresh-hero__copy pop">
          <p class="fresh-kicker">Hampton Vale, Peterborough</p>
          <h1>Good hair.<br /> <em>No appointment.</em></h1>
          <LiveChip design="fresh" />
          <p class="fresh-intro">Walk-in haircuts, skin fades and beard trims. Your neighbourhood barbers since {site.since}.</p>
          <Status />
          <div class="btns"><a class="btn" href={site.directionsUrl}>Get directions</a><a class="btn btn--line" href="#prices">View prices</a></div>
        </div>
        <figure class="fresh-hero__photo up">
          <Image src={shopfront} alt="The Hampton Barbers shop front on Four Chimneys Crescent" widths={[480, 760, 864]} sizes="(max-width: 720px) 92vw, 42vw" loading="eager" fetchpriority="high" />
          <figcaption>Find us here <span>110 Four Chimneys Crescent</span></figcaption>
          <span class="fresh-sticker" aria-hidden="true">Walk-ins<br />welcome!</span>
        </figure>
      </div>
    </section>

    <LiveNow design="fresh" title="How long is the wait?" />

    <section class="wrap fresh-section" id="prices">
      <div class="fresh-heading" data-reveal><p class="fresh-kicker">Services & prices</p><h2>Find your cut.</h2></div>
      <div data-menu="fresh" set:html={renderMenu('fresh', menu)} />
      {isDemo && <p class="fresh-note">Preview prices are based on the shop’s 2022 menu and are awaiting confirmation.</p>}
    </section>

    <section class="fresh-work" id="cuts">
      <div class="wrap fresh-section">
        <div class="fresh-heading" data-reveal><p class="fresh-kicker">Style gallery</p><h2>Find your style.</h2><p>Example photos of each cut. Tap one, then show it to your barber.</p></div>
        <div class="fresh-filters" aria-label="Filter styles" role="group" hidden>
          {filters.map((filter, i) => <button type="button" data-style-filter={filter} aria-pressed={i === 0 ? 'true' : 'false'}>{filter}</button>)}
        </div>
        <p class="sr" data-style-status role="status"></p>
        <div class="fresh-gallery">
          {photos.map(({ src, title, tags, position, full }, i) => (
            <figure data-style-card={JSON.stringify(tags)} data-reveal style={`--d:${i % 4}`}>
              <a href={full} data-gallery-link>
                <Image src={src} alt="" widths={[320, 560, 720]} sizes="(max-width: 720px) 45vw, 32vw" style={{ objectPosition: position }} />
                <span class="gallery-caption">{title}<span aria-hidden="true">+</span></span>
              </a>
            </figure>
          ))}
        </div>
        <dialog class="fresh-dialog" aria-labelledby="style-title">
          <div class="fresh-dialog__bar">
            <h3 id="style-title"></h3>
            <form method="dialog"><button type="submit" autofocus>Close</button></form>
          </div>
          <img alt="" src={photos[0].full} width="720" height="960" loading="lazy" />
          <div class="fresh-dialog__bar"><button type="button" data-gallery-prev>Previous</button><button type="button" data-gallery-next>Next</button></div>
        </dialog>
        <p class="sg-credit">Example photos for inspiration, not taken at Hampton Barbers. Photos from Unsplash by {styles.map((st, i) => <><a href={`${st.byUrl}?utm_source=hampton_barbers&utm_medium=referral`} rel="noopener">{st.by}</a>{i < styles.length - 2 ? ', ' : i === styles.length - 2 ? ' and ' : '.'}</>)}</p>
      </div>
    </section>

    <section class="wrap fresh-section fresh-shop" aria-labelledby="shop-title">
      <Image src={shave} alt="A Hampton barber at work giving a customer a cut-throat shave" widths={[520, 850, 1200]} sizes="(max-width: 720px) 92vw, 46vw" />
      <div class="fresh-heading" data-reveal>
        <p class="fresh-kicker">The shop</p>
        <h2 id="shop-title">Part of Hampton since {site.since}.</h2>
        <p>From a first haircut to a regular trim, bring a photo or tell us what you have in mind. We’ll talk it through in the chair.</p>
        <ShopPhotos class="fresh-shopphotos" />
        <a class="fresh-review" href={site.reviewsUrl}><strong>{site.rating.value}/5</strong><span>Read our {site.rating.count} Google reviews</span></a>
      </div>
    </section>

    <Reviews design="fresh" title="Customers love us." />

    <section class="wrap fresh-section" id="find">
      <div class="fresh-visit">
        <div class="fresh-visit__info">
          <div class="fresh-heading" data-reveal><p class="fresh-kicker">Plan your visit</p><h2>See you soon.</h2></div>
          <Status />
          <address>{site.address.street}<br />{site.address.locality}, {site.address.city} {site.address.postcode}</address>
          <div class="btns"><a class="btn" href={site.directionsUrl}>Get directions</a><button class="btn btn--line" type="button" data-copy-address={address} hidden>Copy address</button></div>
          <p data-copy-status role="status" hidden></p>
          <SpecialHours />
          <div><strong>Regular opening hours</strong><Hours /></div>
          <p><a href={site.phoneHref}>{site.phone}</a></p>
        </div>
        <div class="fresh-visit__visual">
          <Image src={shopfront} alt="Look for the black Hampton Barbers sign above the entrance" widths={[440, 760, 864]} sizes="(max-width: 720px) 92vw, 46vw" />
          <Map />
        </div>
      </div>
    </section>

    <section class="wrap fresh-section fresh-faq">
      <div class="fresh-heading" data-reveal><p class="fresh-kicker">First visit</p><h2>Good to know.</h2></div>
      <div>{faq.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
    </section>
  </main>

  <footer class="fresh-footer"><div class="wrap">
    <strong>Hampton Barbers</strong>
    <nav aria-label="Social links"><a href={site.instagram}>Instagram</a><a href={site.facebook}>Facebook</a><a href={site.reviewsUrl}>Google reviews</a></nav>
    <small>© {new Date().getFullYear()} {site.company}</small>
  </div></footer>
</Base>

<script>
  function setupFresh() {
    const filters = document.querySelector<HTMLElement>('.fresh-filters');
    if (!filters) return;
    const cards = [...document.querySelectorAll<HTMLElement>('[data-style-card]')];
    const galleryStatus = document.querySelector<HTMLElement>('[data-style-status]')!;
    const dialog = document.querySelector<HTMLDialogElement>('.fresh-dialog')!;
    const title = dialog.querySelector('h3')!;
    const image = dialog.querySelector('img')!;
    const previous = dialog.querySelector<HTMLButtonElement>('[data-gallery-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-gallery-next]')!;
    let current = 0;
    let trigger: HTMLAnchorElement | null = null;

    filters.hidden = false;
    filters.addEventListener('click', (event) => {
      const selected = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-style-filter]');
      if (!selected) return;
      const filter = selected.dataset.styleFilter;
      filters.querySelectorAll('button').forEach((button) => button.setAttribute('aria-pressed', String(button === selected)));
      cards.forEach((card) => { card.hidden = filter !== 'All styles' && !JSON.parse(card.dataset.styleCard!).includes(filter); });
      const count = cards.filter((card) => !card.hidden).length;
      galleryStatus.textContent = `${count} ${count === 1 ? 'style' : 'styles'} shown`;
    });

    const visible = () => cards.filter((card) => !card.hidden);
    const show = (index: number) => {
      const shown = visible();
      current = (index + shown.length) % shown.length;
      const link = shown[current].querySelector<HTMLAnchorElement>('a')!;
      title.textContent = link.querySelector('.gallery-caption')!.firstChild!.textContent;
      image.src = link.href;
      image.alt = title.textContent ?? '';
      previous.disabled = next.disabled = shown.length < 2;
    };
    if (typeof dialog.showModal === 'function') {
      cards.forEach((card) => {
        const link = card.querySelector<HTMLAnchorElement>('a')!;
        link.addEventListener('click', (event) => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          trigger = link;
          show(visible().indexOf(card));
          dialog.showModal();
        });
      });
      previous.addEventListener('click', () => show(current - 1));
      next.addEventListener('click', () => show(current + 1));
      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') show(current - 1);
        if (event.key === 'ArrowRight') show(current + 1);
      });
      dialog.addEventListener('close', () => trigger?.focus());
    }

    const copy = document.querySelector<HTMLButtonElement>('[data-copy-address]')!;
    const copyStatus = document.querySelector<HTMLElement>('[data-copy-status]')!;
    if (navigator.clipboard?.writeText) {
      copy.hidden = false;
      copy.addEventListener('click', async () => {
        copyStatus.hidden = false;
        try {
          await navigator.clipboard.writeText(copy.dataset.copyAddress!);
          copyStatus.textContent = 'Address copied.';
        } catch {
          copyStatus.textContent = 'Could not copy the address. You can select it above.';
        }
      });
    }
  }
  setupFresh();
</script>
