---
// The shop's own photos (from its Facebook page, Google listing and old website).
import { Image } from 'astro:assets';
interface Props { class?: string; reveal?: string; photos: string[]; }
const { class: cls, reveal = 'img', photos } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.jpg', { eager: true });
const info: Record<string, { alt: string; cap: string }> = {
  'front-bw': { alt: 'The Hampton Barbers shop front, in black and white', cap: 'On Four Chimneys Crescent' },
  'front-colour': { alt: 'The glass front of Hampton Barbers', cap: 'Right in the centre of Hampton Vale' },
  'shopfront-night': { alt: 'Hampton Barbers shop front lit up in the evening', cap: 'Open late on weekdays' },
  'interior-1': { alt: 'Inside Hampton Barbers: reception desk and barber chairs', cap: 'Walk straight in' },
  'interior-2': { alt: 'Row of barber chairs and lit mirrors inside Hampton Barbers', cap: 'Plenty of chairs' },
  'interior-3': { alt: 'Barber chairs and mirrors inside Hampton Barbers', cap: 'Clean, bright and friendly' },
  'interior-4': { alt: 'A barber chair by the window inside Hampton Barbers', cap: 'Bright and airy' },
};
---
<div class:list={['shop-photos', cls]}>
  {photos.map((key, i) => (
    <figure data-reveal={reveal} style={`--d:${i}`}><Image src={files[`../assets/photos/${key}.jpg`].default} alt={info[key].alt} widths={[400, 800]} sizes="(max-width: 700px) 46vw, 30vw" /><figcaption>{info[key].cap}</figcaption></figure>
  ))}
</div>
