---
// Compact live status for the first screen. Tapping it jumps to the full panel.
// When the visitor has joined the queue, it also shows their place in line.
import { boardView, exampleBoard } from '../lib/board';
interface Props { design: 'heritage' | 'fresh' | 'street' | 'club'; shop?: string; class?: string; }
const { design, shop = 'hampton-vale', class: cls } = Astro.props;
const now = Date.now();
const v = boardView(exampleBoard(shop, now), now);
---
<a class:list={['lchip', `lchip--${design}`, cls]} href="#live" data-live-root={shop} data-level={v.level} aria-label="Live wait time. See how busy the shop is, or join the queue">
  <span class="lchip__live"><i aria-hidden="true"></i>Live</span>
  <span class="lchip__wait"><b data-live="headline">{v.headline}</b><small data-live="unit">{v.unit}</small></span>
  <span class="lchip__meta"><strong data-live="label">{v.label}</strong><span class="lchip__counts"><span data-live="free">{v.freeChairs}</span> free · <span data-live="waiting">{v.waiting}</span> waiting · <u>Join the queue</u></span></span>
  <span class="lchip__go" aria-hidden="true">→</span>
</a>
