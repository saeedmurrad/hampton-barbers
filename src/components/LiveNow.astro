---
// Live wait, chairs and queue for one shop, and the owner's three shops side by side.
// Joining and the customer's own ticket live on the queue page (/queue/<shop>/): this panel
// links there, and shows a short strip when the visitor already holds a ticket.
import { site, shops } from '../data/site';
import { boardView, exampleBoard } from '../lib/board';
import { chairsHtml, queueHtml } from '../lib/live';
interface Props { design: 'heritage' | 'fresh' | 'street' | 'club'; shop?: string; title?: string; }
const { design, shop = 'hampton-vale', title = 'Right now at Hampton Barbers' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const now = Date.now();
const order = [shop, ...shops.map((s) => s.id).filter((id) => id !== shop)];
const entries = order.map((id) => ({ shop: shops.find((s) => s.id === id)!, v: boardView(exampleBoard(id, now), now) }));
const v = entries[0].v;
const best = entries.reduce((a, b) => (b.v.minutes < a.v.minutes ? b : a)).shop;
const steps = ['Quiet', 'Short wait', 'Busy', 'Very busy'];
---
<section class:list={['live', `live--${design}`]} id="live" data-live-root={shop} data-base={base} data-level={v.level} aria-labelledby="live-title">
  <div class="live__in">
    <header class="live__head">
      <p class="live__badge"><i aria-hidden="true"></i>Live</p>
      <h2 id="live-title">{title}</h2>
      <p class="live__ago" data-live="ago">Example status for this demo</p>
    </header>

    <a class="live__mine" data-my-ticket href={`${base}/queue/${shop}/`} hidden>
      <span class="live__mine-n"><b data-my="n"></b><small>your<br />number</small></span>
      <span class="live__mine-t"><b data-my="text"></b><small data-my="shop"></small></span>
      <span class="live__mine-go">Open my ticket →</span>
    </a>

    <div class="live__grid">
      <div class="live__wait" aria-live="polite">
        <p class="live__label" data-live="label">{v.label}</p>
        <p class="live__big"><b data-live="headline">{v.headline}</b><small data-live="unit">{v.unit}</small></p>
        <p class="live__range">Estimated wait: <span data-live="range">{v.range}</span></p>
        <div class="live__meter" data-live-meter role="img" aria-label="How busy the shop is">
          {steps.map((t, i) => <i class:list={[{ on: v.level > 0 && i < v.level }]}><span>{t}</span></i>)}
        </div>
        <p class="live__note" data-live="note" hidden={!v.note}>{v.note}</p>
        <div class="live__join">
          <a class="btn" data-join href={`${base}/queue/${shop}/?join=1`}>Join the queue</a>
          <p class="live__join-none">Save your place from home. No booking, no account.</p>
          <p class="live__join-mine">You have a place in the queue: your ticket is just above.</p>
        </div>
      </div>

      <div class="live__floor">
        <div class="live__block">
          <h3>Barber chairs</h3>
          <ul class="live__chairs" data-live-chairs set:html={chairsHtml(v)} />
        </div>
        <div class="live__block">
          <h3>Waiting <span class="live__key"><i class="k-shop"></i>In the shop <i class="k-online"></i>On the way</span></h3>
          <ul class="live__queue" data-live-queue set:html={queueHtml(v)} />
        </div>
        <dl class="live__stats">
          <div><dt>Barbers cutting</dt><dd data-live="barbers">{v.barbers}</dd></div>
          <div><dt>Chairs free</dt><dd data-live="free">{v.freeChairs}</dd></div>
          <div><dt>People waiting</dt><dd data-live="waiting">{v.waiting}</dd></div>
        </dl>
      </div>
    </div>

    <div class="live__shops">
      <div class="live__shops-head">
        <h3>All three shops right now</h3>
        <p data-shops-tip>{best.id === shop ? 'This shop is the quickest right now.' : `${best.name} is the quickest right now.`}</p>
      </div>
      <ul data-live-shops>
        {entries.map((e) => (
          <li data-shop-key={e.shop.id} data-name={e.shop.name} data-level={e.v.level} class:list={[{ best: e.shop.id === best.id, here: e.shop.id === shop }]}>
            <span class="live__shop-name"><b>{e.shop.name}</b><small>{e.shop.place}</small></span>
            <span class="live__shop-wait"><b data-sw="headline">{e.v.headline}</b><small data-sw="unit">{e.v.unit}</small></span>
            <span class="live__shop-label" data-sw="label">{e.v.label}</span>
            <span class="live__shop-tags"><em class="t-best">Quickest</em>{e.shop.id === shop && <em class="t-here">This shop</em>}</span>
            <span class="live__shop-go">
              <a href={`${base}/queue/${e.shop.id}/`} data-queue-link>Queue and tickets →</a>
              {e.shop.directionsUrl ? <a href={e.shop.directionsUrl} rel="noopener">Directions</a> : <span class="is-off">Directions coming soon</span>}
            </span>
          </li>
        ))}
      </ul>
    </div>

    <footer class="live__foot">
      <p>Times are estimates from the shop’s own screen. Only people in the shop are called, in number order.</p>
      {shop === 'hampton-vale' && <div class="btns"><a class="btn btn--line" href={site.phoneHref}>Call {site.phone}</a><a class="btn btn--line" href={site.directionsUrl} rel="noopener">Directions</a></div>}
    </footer>
  </div>
</section>

<script>
  import { boardView, londonDay, type Board } from '../lib/board';
  import { TICKET_KEY, fetchBoards, onDeviceChange, pickBoard, read, type Mine } from '../lib/store';
  import { mineText, paintLive } from '../lib/live';

  const panel = document.querySelector<HTMLElement>('section.live[data-live-root]');
  if (panel) {
    const shop = panel.dataset.liveRoot!;
    const base = panel.dataset.base ?? '';
    const keys = [...panel.querySelectorAll<HTMLElement>('[data-shop-key]')].map((li) => li.dataset.shopKey!);
    const chips = [...document.querySelectorAll<HTMLAnchorElement>('a.lchip[data-live-root]')];
    const strip = panel.querySelector<HTMLAnchorElement>('[data-my-ticket]')!;
    const shopName = (k: string) => panel.querySelector<HTMLElement>(`[data-shop-key="${k}"]`)?.dataset.name ?? 'the shop';
    // Local testing only: keep ?emulator on the links to the queue page.
    const emulator = new URLSearchParams(location.search).has('emulator');
    const queueUrl = (k: string, join = false) => `${base}/queue/${k}/${join ? `?join=1${emulator ? '&emulator' : ''}` : emulator ? '?emulator' : ''}`;
    if (emulator) {
      panel.querySelector<HTMLAnchorElement>('[data-join]')!.href = queueUrl(shop, true);
      panel.querySelectorAll<HTMLAnchorElement>('[data-queue-link]').forEach((a) => { a.href = queueUrl(a.closest<HTMLElement>('[data-shop-key]')!.dataset.shopKey!); });
    }

    let cloud: Record<string, Board> = {};
    const pick = (k: string) => pickBoard(k, cloud[k]);
    // The visitor's ticket, if they took one today on the queue page.
    const myTicket = () => { const m = read<Mine>(TICKET_KEY); return m && londonDay(m.at) === londonDay(Date.now()) ? m : null; };
    const say = (el: Element | null, t: string) => { if (el && el.textContent !== t) el.textContent = t; };

    const paintShops = (now: number) => {
      const views = Object.fromEntries(keys.map((k) => [k, boardView(pick(k).board, now)]));
      const best = keys.reduce((a, k) => (views[k].minutes < views[a].minutes ? k : a), keys[0]);
      panel.querySelectorAll<HTMLElement>('[data-shop-key]').forEach((li) => {
        const k = li.dataset.shopKey!;
        li.dataset.level = String(views[k].level);
        li.classList.toggle('best', k === best);
        say(li.querySelector('[data-sw="headline"]'), views[k].headline);
        say(li.querySelector('[data-sw="unit"]'), views[k].unit);
        say(li.querySelector('[data-sw="label"]'), views[k].label);
      });
      const bv = views[best];
      say(panel.querySelector('[data-shops-tip]'), best === shop
        ? 'This shop is the quickest right now.'
        : `${shopName(best)} is the quickest right now: ${bv.headline === 'No wait' ? 'no wait' : `${bv.headline} ${bv.unit}`}.`);
    };

    // A short line about the visitor's own ticket, here and on the first-screen card. Both
    // open the queue page, where the ticket itself lives.
    const paintMine = (now: number) => {
      const m = myTicket();
      const board = m ? pick(m.shop).board : null;
      const text = m && board ? mineText(board, m.id, now) : '';
      const url = m ? queueUrl(m.shop) : '';
      strip.hidden = !text;
      if (m && board && text) {
        strip.href = url;
        say(strip.querySelector('[data-my="n"]'), String(board.t[m.id]?.n ?? ''));
        say(strip.querySelector('[data-my="text"]'), text);
        say(strip.querySelector('[data-my="shop"]'), `${m.name ? `${m.name}, ` : ''}Hampton Barbers ${shopName(m.shop)}`);
      }
      panel.classList.toggle('has-ticket', Boolean(text));
      chips.forEach((c) => {
        const href = text ? url : '#live';
        if (c.getAttribute('href') !== href) {
          c.setAttribute('href', href);
          c.setAttribute('aria-label', text ? `Your ticket: ${text} Open my ticket` : 'Live wait time. See how busy the shop is, or join the queue');
        }
        const old = c.querySelector<HTMLElement>('[data-mine]');
        if ((old?.textContent ?? '') === text) return;
        old?.remove();
        if (text) c.querySelector('.lchip__meta')?.insertAdjacentHTML('beforeend', '<span class="lchip__mine" data-mine></span>');
        say(c.querySelector('[data-mine]'), text);
      });
    };

    const render = () => {
      const now = Date.now();
      const cur = pick(shop);
      const view = boardView(cur.board, now);
      const m = myTicket();
      paintLive(panel, view, cur.board.updatedAt, m?.shop === shop ? m.id : undefined);
      chips.forEach((c) => paintLive(c, view, cur.board.updatedAt));
      paintShops(now);
      paintMine(now);
    };

    // ---- keeping up to date ----
    render();
    const refresh = async () => {
      const got = await fetchBoards();
      if (got) for (const [k, b] of Object.entries(got)) if (!cloud[k] || b.updatedAt >= cloud[k].updatedAt) cloud = { ...cloud, [k]: b };
      render();
    };
    refresh();
    let tick = 0;
    setInterval(() => {
      tick++;
      // Every minute, or every half minute while the visitor is waiting for their turn.
      if (tick % (myTicket() ? 2 : 4) === 0 && document.visibilityState === 'visible') refresh(); else render();
    }, 15_000);
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'visible') refresh(); });
    // When another tab on this device changes things (a ticket taken, the demo queue desk), follow straight away.
    onDeviceChange(() => { render(); refresh(); });
  }
</script>
