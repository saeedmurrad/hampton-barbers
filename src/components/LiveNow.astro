---
// "Right now at Hampton Barbers": live wait, chairs and queue for this shop, the owner's
// three shops side by side, and joining the queue online.
import { site, shops } from '../data/site';
import { LIVE_DEMO, viewOf, agoText, chairsHtml, queueHtml, quickestKey } from '../lib/live';
interface Props { design: 'heritage' | 'fresh' | 'street' | 'club'; title?: string; }
const { design, title = 'Right now at Hampton Barbers' } = Astro.props;
const s = LIVE_DEMO[design];
const v = viewOf(s);
const steps = ['Quiet', 'Short wait', 'Busy', 'Very busy'];
const keys = [design, 'shop-2', 'shop-3'];
const entries = keys.map((key, i) => ({ key, shop: shops[i], v: viewOf(LIVE_DEMO[key]) }));
const best = quickestKey(keys, (k) => LIVE_DEMO[k]);
const etas: [number, string][] = [[0, 'Now'], [10, 'In 10 min'], [20, 'In 20 min'], [30, 'In 30 min']];
---
<section class:list={['live', `live--${design}`]} id="live" data-live-root={design} data-level={v.level} aria-labelledby="live-title">
  <div class="live__in">
    <header class="live__head">
      <p class="live__badge"><i aria-hidden="true"></i>Live</p>
      <h2 id="live-title">{title}</h2>
      <p class="live__ago" data-live="ago">{agoText(s.updatedAt)}</p>
    </header>

    <div class="live__ticket" data-ticket aria-live="polite" hidden></div>

    <div class="live__grid">
      <div class="live__wait" aria-live="polite">
        <p class="live__label" data-live="label">{v.label}</p>
        <p class="live__big"><b data-live="headline">{v.headline}</b><small data-live="unit">{v.unit}</small></p>
        <p class="live__range">Estimated wait: <span data-live="range">{v.range}</span></p>
        <div class="live__meter" data-live-meter role="img" aria-label="How busy the shop is">
          {steps.map((t, i) => <i class:list={[{ on: v.level > 0 && i < v.level }]}><span>{t}</span></i>)}
        </div>
        <p class="live__note" data-live="note" hidden={!v.note}>{v.note}</p>
        <div class="live__join">
          <button type="button" class="btn" data-join>Join the queue</button>
          <p>Save your place from home. No booking, no account.</p>
        </div>
      </div>

      <div class="live__floor">
        <div class="live__block">
          <h3>Barber chairs</h3>
          <ul class="live__chairs" data-live-chairs set:html={chairsHtml(v)} />
        </div>
        <div class="live__block">
          <h3>Waiting <span class="live__key"><i class="k-shop"></i>In the shop <i class="k-online"></i>Joined online</span></h3>
          <ul class="live__queue" data-live-queue set:html={queueHtml(v)} />
        </div>
        <dl class="live__stats">
          <div><dt>Barbers cutting</dt><dd data-live="barbers">{v.barbers}</dd></div>
          <div><dt>Chairs free</dt><dd data-live="free">{v.freeChairs}</dd></div>
          <div><dt>People waiting</dt><dd data-live="waiting">{v.waiting}</dd></div>
        </dl>
      </div>
    </div>

    <div class="live__shops">
      <div class="live__shops-head">
        <h3>All three shops right now</h3>
        <p data-shops-tip>{best === design ? 'This shop is the quickest right now.' : `${entries.find((e) => e.key === best)!.shop.name} is the quickest right now.`}</p>
      </div>
      <ul data-live-shops>
        {entries.map((e) => (
          <li data-shop-key={e.key} data-name={e.shop.name} data-level={e.v.level} class:list={[{ best: e.key === best, here: e.key === design }]}>
            <span class="live__shop-name"><b>{e.shop.name}</b><small>{e.shop.place}</small></span>
            <span class="live__shop-wait"><b data-sw="headline">{e.v.headline}</b><small data-sw="unit">{e.v.unit}</small></span>
            <span class="live__shop-label" data-sw="label">{e.v.label}</span>
            <span class="live__shop-tags"><em class="t-best">Quickest</em>{e.key === design && <em class="t-here">This shop</em>}</span>
            {e.shop.directionsUrl
              ? <a class="live__shop-go" href={e.shop.directionsUrl} rel="noopener">Directions →</a>
              : <span class="live__shop-go is-off">Directions coming soon</span>}
          </li>
        ))}
      </ul>
    </div>

    <footer class="live__foot">
      <p>A rough guide set by the shop. Walk-ins and online joiners are seen in order.</p>
      <div class="btns"><a class="btn btn--line" href={site.phoneHref}>Call {site.phone}</a><a class="btn btn--line" href={site.directionsUrl} rel="noopener">Directions</a></div>
    </footer>
  </div>

  <dialog class:list={['qdlg', `qdlg--${design}`]} id="join-dialog" aria-labelledby="qdlg-title">
    <form class="qdlg__form" data-join-form>
      <h2 id="qdlg-title">Join the queue</h2>
      <p class="qdlg__lead">Save your place, then come in when it’s nearly your turn. No booking and no account.</p>
      <label class="qdlg__field">Your first name
        <input name="name" required maxlength="24" autocomplete="given-name" placeholder="e.g. Sam" />
      </label>
      <fieldset class="qdlg__pick qdlg__pick--shops">
        <legend>Which shop?</legend>
        {entries.map((e, i) => (
          <label><input type="radio" name="shop" value={e.key} checked={i === 0} /><span><b>{e.shop.name}</b><small data-qshop={e.key}>{e.v.headline} {e.v.unit}</small></span></label>
        ))}
      </fieldset>
      <fieldset class="qdlg__pick">
        <legend>When will you get here?</legend>
        {etas.map(([m, t], i) => <label><input type="radio" name="eta" value={m} checked={i === 1} /><span>{t}</span></label>)}
      </fieldset>
      <p class="qdlg__small">We keep only your first name, and only until your cut is done. You can leave the queue at any time.</p>
      <p class="qdlg__err" data-join-error role="alert" hidden></p>
      <div class="qdlg__btns">
        <button type="button" class="btn btn--line" data-join-cancel>Cancel</button>
        <button type="submit" class="btn" data-join-submit>Join the queue</button>
      </div>
    </form>
  </dialog>
</section>

<script>
  import {
    LIVE_KEY, TICKET_KEY, TICKETS_KEY, LIVE_DEMO, LIVE_KEYS, parseLiveAll, fetchLiveStatus, paintLive,
    newest, viewOf, waitForPosition, waitText, quickestKey, cleanStatus, type LiveAll,
  } from '../lib/live';

  type Ticket = { id: string; shop: string; name: string; eta: number; createdAt: number; cloud: boolean };

  const panel = [...document.querySelectorAll<HTMLElement>('section.live[data-live-root]')].find((el) => !el.closest('[data-live-preview]'));
  if (panel) {
    const design = panel.dataset.liveRoot!;
    const keys = [design, 'shop-2', 'shop-3'];
    const chips = [...document.querySelectorAll<HTMLElement>('.lchip[data-live-root]')];
    const ticketEl = panel.querySelector<HTMLElement>('[data-ticket]')!;
    const dialog = panel.querySelector<HTMLDialogElement>('#join-dialog')!;
    const form = dialog.querySelector<HTMLFormElement>('[data-join-form]')!;
    const errEl = dialog.querySelector<HTMLElement>('[data-join-error]')!;
    const submitBtn = dialog.querySelector<HTMLButtonElement>('[data-join-submit]')!;
    const shopName = (k: string) => panel.querySelector<HTMLElement>(`[data-shop-key="${k}"]`)?.dataset.name ?? 'the shop';
    const esc = (x: unknown) => String(x ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
    const ord = (n: number) => { const s = ['th', 'st', 'nd', 'rd'], v = n % 100; return n + (s[(v - 20) % 10] || s[v] || s[0]); };
    const read = <T,>(k: string): T | null => { try { const x = localStorage.getItem(k); return x ? JSON.parse(x) as T : null; } catch { return null; } };
    const write = (k: string, x: unknown) => { try { if (x === null) localStorage.removeItem(k); else localStorage.setItem(k, JSON.stringify(x)); } catch { /* storage blocked */ } };

    let local: LiveAll | null = null;
    try { local = parseLiveAll(localStorage.getItem(LIVE_KEY)); } catch { /* storage blocked */ }
    let published: LiveAll | null = null;
    let ticket = read<Ticket>(TICKET_KEY);
    let lastAhead = Infinity;
    let announcedTurn = false;
    const pick = (k: string) => newest(local?.[k], published?.[k], LIVE_DEMO[k]);

    const notify = (title: string, body: string) => {
      try { navigator.vibrate?.([220, 120, 220]); } catch { /* not supported */ }
      try { if ('Notification' in window && Notification.permission === 'granted') new Notification(title, { body }); } catch { /* not supported */ }
      const old = document.title; let n = 0;
      const t = setInterval(() => { document.title = n++ % 2 ? old : `● ${title}`; if (n > 9) { clearInterval(t); document.title = old; } }, 900);
    };

    type TicketState = { kind: 'waiting'; ahead: number; wait: number; checking: boolean } | { kind: 'turn' } | { kind: 'gone' };
    const stateOf = (t: Ticket): TicketState => {
      const s = pick(t.shop);
      const i = s.line.indexOf(t.id);
      if (i >= 0) return { kind: 'waiting', ahead: i, wait: waitForPosition(s, i), checking: false };
      if (s.called.includes(t.id)) return { kind: 'turn' };
      // Just joined and the shop's screen hasn't added you yet: show where you'll be.
      if (Date.now() - t.createdAt < 3 * 60_000) return { kind: 'waiting', ahead: s.line.length, wait: waitForPosition(s, s.line.length), checking: true };
      return { kind: 'gone' };
    };

    const paintShops = () => {
      const best = quickestKey(keys, pick);
      panel.querySelectorAll<HTMLElement>('[data-shop-key]').forEach((li) => {
        const k = li.dataset.shopKey!;
        const v = viewOf(pick(k));
        li.dataset.level = String(v.level);
        li.classList.toggle('best', k === best);
        li.querySelector('[data-sw="headline"]')!.textContent = v.headline;
        li.querySelector('[data-sw="unit"]')!.textContent = v.unit;
        li.querySelector('[data-sw="label"]')!.textContent = v.label;
      });
      const tip = panel.querySelector<HTMLElement>('[data-shops-tip]')!;
      const bv = viewOf(pick(best));
      tip.textContent = best === design ? 'This shop is the quickest right now.' : `${shopName(best)} is the quickest right now: ${bv.headline === 'No wait' ? 'no wait' : `${bv.headline} ${bv.unit}`}.`;
      dialog.querySelectorAll<HTMLElement>('[data-qshop]').forEach((el) => { const v = viewOf(pick(el.dataset.qshop!)); el.textContent = `${v.headline} ${v.unit}`.trim(); });
    };

    const paintTicket = () => {
      chips.forEach((c) => c.querySelector('[data-mine]')?.remove());
      if (!ticket) { ticketEl.hidden = true; ticketEl.innerHTML = ''; panel.classList.remove('has-ticket'); return; }
      const st = stateOf(ticket);
      const where = esc(shopName(ticket.shop));
      ticketEl.hidden = false;
      panel.classList.add('has-ticket');
      let chipText = '';
      if (st.kind === 'waiting') {
        const pos = st.ahead + 1;
        const w = waitText(st.wait);
        const next = st.ahead === 0;
        ticketEl.dataset.state = next ? 'next' : 'waiting';
        ticketEl.innerHTML = `
          <div class="tk">
            <p class="tk__kicker">${st.checking ? 'Checking you in at' : 'You’re in the queue at'} ${where}, ${esc(ticket.name)}</p>
            <div class="tk__main">
              <p class="tk__big"><b>${pos}</b><small>${ord(pos).replace(String(pos), '')}<br />in line</small></p>
              <div class="tk__info">
                <p class="tk__line">${next ? 'You’re next. Head in now.' : `${st.ahead} ${st.ahead === 1 ? 'person' : 'people'} ahead of you`}</p>
                <p class="tk__wait">${st.wait === 0 ? 'A barber should be free for you' : `Estimated wait ${w.range}`}</p>
                <p class="tk__sub">You said you’d arrive ${ticket.eta ? `in about ${ticket.eta} minutes` : 'now'}. We’ll keep your place, just come in when you’re near the front.</p>
              </div>
            </div>
            <div class="tk__btns">
              ${'Notification' in window && Notification.permission === 'default' ? '<button type="button" class="btn" data-alert>Alert me when I’m next</button>' : ''}
              <button type="button" class="btn btn--line" data-leave>Leave the queue</button>
            </div>
          </div>`;
        chipText = next ? 'You’re next!' : `You’re ${ord(pos)} in line`;
        if (next && lastAhead !== Infinity && lastAhead > 0) notify('You’re next at Hampton Barbers', 'Head in now, a barber will be free in a moment.');
        lastAhead = st.ahead;
      } else if (st.kind === 'turn') {
        ticketEl.dataset.state = 'turn';
        ticketEl.innerHTML = `
          <div class="tk">
            <p class="tk__kicker">${where}</p>
            <p class="tk__turn">It’s your turn, ${esc(ticket.name)}! Come and take a seat.</p>
            <div class="tk__btns"><button type="button" class="btn" data-done>Done</button></div>
          </div>`;
        chipText = 'It’s your turn!';
        if (!announcedTurn) { announcedTurn = true; notify('It’s your turn at Hampton Barbers', 'Come and take a seat.'); }
      } else {
        ticketEl.dataset.state = 'gone';
        ticketEl.innerHTML = `
          <div class="tk">
            <p class="tk__turn">You’re no longer in the queue at ${where}.</p>
            <p class="tk__sub">If that’s a mistake, call the shop or join again.</p>
            <div class="tk__btns"><button type="button" class="btn" data-again>Join again</button><button type="button" class="btn btn--line" data-done>Close</button></div>
          </div>`;
      }
      if (chipText) chips.forEach((c) => {
        const meta = c.querySelector('.lchip__meta');
        if (meta) meta.insertAdjacentHTML('beforeend', `<span class="lchip__mine" data-mine>${chipText}</span>`);
      });
    };

    const render = () => {
      const mine = ticket?.shop === design ? ticket.id : undefined;
      paintLive(panel, pick(design), mine);
      chips.forEach((c) => paintLive(c, pick(design)));
      paintShops();
      paintTicket();
    };

    // ---- joining and leaving ----
    const openJoin = () => {
      errEl.hidden = true;
      if (ticket && stateOf(ticket).kind === 'waiting') { ticketEl.scrollIntoView({ behavior: 'smooth', block: 'center' }); return; }
      dialog.showModal();
      dialog.querySelector<HTMLInputElement>('input[name="name"]')!.focus();
    };
    panel.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('[data-join]') || t.closest('[data-again]')) { if (t.closest('[data-again]')) { ticket = null; write(TICKET_KEY, null); } openJoin(); }
      else if (t.closest('[data-join-cancel]')) dialog.close();
      else if (t.closest('[data-leave]')) leave();
      else if (t.closest('[data-done]')) { ticket = null; write(TICKET_KEY, null); render(); }
      else if (t.closest('[data-alert]')) Notification.requestPermission().then(render);
    });
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const name = String(data.get('name') ?? '').trim().replace(/\s+/g, ' ').slice(0, 24);
      const shop = String(data.get('shop') ?? design);
      const eta = Number(data.get('eta') ?? 10);
      if (!name) { errEl.textContent = 'Please add your first name.'; errEl.hidden = false; return; }
      submitBtn.disabled = true; submitBtn.textContent = 'Joining…';
      let id = '', cloud = false;
      try {
        const q = await import('../lib/queue');
        id = await q.joinCloud({ shop, name, eta });
        cloud = true;
      } catch {
        // Offline or not connected: keep the place on this device so the demo still works.
        id = `local${Math.random().toString(36).slice(2, 12)}`;
      }
      ticket = { id, shop, name, eta, createdAt: Date.now(), cloud };
      write(TICKET_KEY, ticket);
      const mineList = (read<Ticket[]>(TICKETS_KEY) ?? []).filter((x) => Date.now() - x.createdAt < 12 * 3_600_000);
      write(TICKETS_KEY, [...mineList, ticket].slice(-30));
      // Show yourself in the line straight away on this device.
      const all: LiveAll = Object.fromEntries(LIVE_KEYS.map((k) => [k, pick(k)]));
      all[shop] = cleanStatus({ ...all[shop], line: [...all[shop].line, id], updatedAt: Date.now() }, LIVE_DEMO[shop]);
      local = all;
      write(LIVE_KEY, all);
      lastAhead = Infinity; announcedTurn = false;
      submitBtn.disabled = false; submitBtn.textContent = 'Join the queue';
      form.reset();
      dialog.close();
      render();
      ticketEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });

    const leave = async () => {
      if (!ticket) return;
      const t = ticket;
      ticket = null;
      write(TICKET_KEY, null);
      write(TICKETS_KEY, (read<Ticket[]>(TICKETS_KEY) ?? []).filter((x) => x.id !== t.id));
      const s = pick(t.shop);
      if (s.line.includes(t.id)) {
        const all: LiveAll = Object.fromEntries(LIVE_KEYS.map((k) => [k, pick(k)]));
        all[t.shop] = cleanStatus({ ...s, line: s.line.filter((x) => x !== t.id), updatedAt: Date.now() }, LIVE_DEMO[t.shop]);
        local = all;
        write(LIVE_KEY, all);
      }
      render();
      if (t.cloud) { try { (await import('../lib/queue')).leaveCloud(t.id); } catch { /* the shop's screen tidies up old places */ } }
    };

    // ---- keeping up to date ----
    render();
    const refresh = async () => { const got = await fetchLiveStatus(); if (got) { published = got; } render(); };
    refresh();
    let tick = 0;
    setInterval(() => { tick++; if (ticket || tick % 6 === 0) refresh(); else render(); }, 10_000);
    // When the admin page (or another tab) changes things on this device, follow straight away.
    addEventListener('storage', (e) => {
      if (e.key === LIVE_KEY) { local = parseLiveAll(e.newValue); render(); }
      if (e.key === TICKET_KEY) { ticket = read<Ticket>(TICKET_KEY); render(); }
    });
  }
</script>
