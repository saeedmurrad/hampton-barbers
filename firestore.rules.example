rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownerPath() {
      return /databases/$(database)/documents/site/owner;
    }
    // The owner, or anyone the owner has added to the admins list, may change the price list.
    // Real accounts only (email and password, or Google): an anonymous sign-in never counts.
    // Customers have real accounts too, so an account alone gives no staff rights: those come
    // from the owner record and the staff records below.
    function isAccount() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider in ['password', 'google.com'];
    }
    // A customer who has filled in their details (first name, email, mobile).
    function isCustomer() {
      return isAccount() && exists(/databases/$(database)/documents/customers/$(request.auth.uid));
    }
    function isAdmin() {
      return (isAccount()
        && exists(ownerPath())
        && (get(ownerPath()).data.uid == request.auth.uid
            || request.auth.uid in get(ownerPath()).data.get('admins', [])))
        || isStaff();
    }
    // A staff login: an account the owner has added for a barber or for the shop tablet.
    // It can run the queue and record sales. It cannot read takings, percentages or other logins.
    function staffPath() {
      return /databases/$(database)/documents/staff/$(request.auth.uid);
    }
    function isStaff() {
      return isAccount() && exists(staffPath());
    }

    // The owner alone: the account that set the site up. Money (takings, percentages) is for
    // the owner only; other staff logins can run the queue and record sales but not read them back.
    function isOwner() {
      return isAccount() && exists(ownerPath()) && get(ownerPath()).data.uid == request.auth.uid;
    }

    // The published price list: anyone can read it, only admins can change it.
    match /site/menu {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['json', 'visit', 'updatedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 20000
        && request.resource.data.get('visit', '') is string
        && request.resource.data.get('visit', '').size() < 12000;
    }

    // Live shop status (how busy the shop is): anyone can read it, only admins can change it.
    match /site/live {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 20000;
    }

    // Tickets from the first version of the online queue. Nothing new is written here any more
    // (the queue now lives in /boards); what is already stored stays readable by its owner.
    match /tickets/{id} {
      allow create: if false;
      allow get: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow update: if false;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // The live queue: one board per shop. Everyone can read it, and it never holds a name:
    // only ticket numbers, chairs, barbers' first names and times.
    // Staff can change anything on it. A customer can do four things only, and only to the one
    // ticket filed under their own account. Taking a number needs an account with details:
    // take the next number, mark it arrived, extend it once ("running late"), or remove it.
    match /boards/{shop} {
      function before() { return resource.data; }
      function after() { return request.resource.data; }
      function me() { return request.auth.uid; }
      function onlyMyTicket() {
        return after().t.diff(before().t).affectedKeys().hasOnly([me()]) && after().updatedAt is int;
      }
      function validBoard() {
        return after().keys().hasOnly(['v', 'day', 'online', 'seq', 'staff', 't', 'avg', 'obs', 'done', 'mode', 'note', 'call', 'updatedAt'])
          && after().day is string && after().seq is int && after().online is bool
          && after().t is map && after().t.size() <= 80
          && after().staff is map && after().staff.size() <= 12
          && after().note is string && after().note.size() <= 120
          && after().updatedAt is int;
      }
      function joins() {
        return isCustomer()
          && before().online == true
          && after().diff(before()).affectedKeys().hasOnly(['seq', 't', 'updatedAt'])
          && after().seq == before().seq + 1
          && onlyMyTicket()
          && !(me() in before().t)
          && before().t.size() < 40
          && after().t[me()].keys().hasOnly(['n', 's', 'at', 'eta', 'src'])
          && after().t[me()].keys().hasAll(['n', 's', 'at', 'eta', 'src'])
          && after().t[me()].n == after().seq
          && after().t[me()].s in ['way', 'here']
          && after().t[me()].at is int
          && after().t[me()].eta is int && after().t[me()].eta >= 0 && after().t[me()].eta <= 60
          && after().t[me()].src in ['web', 'qr'];
      }
      function changesOwn() {
        return after().diff(before()).affectedKeys().hasOnly(['t', 'updatedAt'])
          && onlyMyTicket()
          && me() in before().t && me() in after().t
          && before().t[me()].s == 'way'
          && after().t[me()].diff(before().t[me()]).affectedKeys().hasOnly(['s', 'arr', 'eta', 'late'])
          && after().t[me()].s in ['way', 'here']
          && after().t[me()].get('arr', 0) is int
          && after().t[me()].eta is int
          && ((after().t[me()].eta == before().t[me()].eta
                && after().t[me()].get('late', 0) == before().t[me()].get('late', 0))
              || (before().t[me()].get('late', 0) == 0 && after().t[me()].get('late', 0) == 1
                && after().t[me()].eta > before().t[me()].eta && after().t[me()].eta <= 120));
      }
      function leaves() {
        return after().diff(before()).affectedKeys().hasOnly(['t', 'updatedAt'])
          && onlyMyTicket()
          && me() in before().t && !(me() in after().t)
          && before().t[me()].s in ['way', 'here'];
      }
      allow read: if true;
      allow create: if isAdmin() && shop in ['hampton-vale', 'shop-2', 'shop-3'] && validBoard();
      allow update: if (isAdmin() && validBoard())
        || (request.auth != null && (joins() || changesOwn() || leaves()));
      allow delete: if false;

      // First names, kept apart from the public board. A visitor can see and remove only
      // their own; staff can see them all. Removed when the cut is done.
      match /names/{id} {
        allow get: if request.auth != null && (request.auth.uid == id || isAdmin());
        allow list: if isAdmin();
        allow create, update: if request.auth != null && (request.auth.uid == id || isAdmin())
          && request.resource.data.keys().hasOnly(['name', 'at'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 24
          && request.resource.data.at is int;
        allow delete: if request.auth != null && (request.auth.uid == id || isAdmin());
      }

      // Sales: one record per finished cut (what they had, the price, cash or online, which
      // barber). No payment is taken here; it is only written down. Staff can add a sale and
      // correct their own within ten minutes. Only the owner can read them all, correct them
      // later or cancel one, and a cancelled sale keeps its record. Nothing is ever deleted.
      match /sales/{id} {
        function sale() { return request.resource.data; }
        function validSale() {
          return sale().keys().hasOnly(['shop', 'day', 'at', 'ts', 'b', 'bn', 'chair', 'n', 'src', 'svc', 'price', 'pay', 'wait', 'mins', 'by', 'was', 'void'])
            && sale().shop == shop
            && sale().day is string && sale().day.size() == 10
            && sale().at is int
            && sale().b is string && sale().b.size() <= 40
            && sale().bn is string && sale().bn.size() <= 30
            && sale().n is int && sale().chair is int
            && sale().svc is string && sale().svc.size() >= 1 && sale().svc.size() <= 80
            && sale().price is int && sale().price >= 0 && sale().price <= 100000
            && sale().pay in ['cash', 'online', 'none']
            && sale().wait is int && sale().mins is int;
        }
        allow create: if isAdmin() && validSale()
          && sale().by == request.auth.uid
          && !('void' in sale()) && !('was' in sale())
          && sale().ts == request.time; // stamped by the server, not by the phone's clock
        allow get: if isOwner() || (isAdmin() && resource.data.by == request.auth.uid);
        // The owner sees every sale. A barber's own login can list that barber's own sales
        // (to show "your takings today"), and nobody else's.
        allow list: if isOwner()
          || (isStaff() && get(staffPath()).data.shop == shop && resource.data.b == get(staffPath()).data.b);
        allow update: if validSale()
          && ((isOwner() && sale().diff(resource.data).affectedKeys().hasOnly(['svc', 'price', 'pay', 'was', 'void']))
            || (isAdmin() && resource.data.by == request.auth.uid
              && request.time < resource.data.ts + duration.value(10, 'm')
              && !('void' in resource.data)
              && sale().diff(resource.data).affectedKeys().hasOnly(['svc', 'price', 'pay', 'was'])));
        allow delete: if false;
      }

      // The owner's private settings for this shop, such as each barber's percentage.
      match /private/{doc} {
        allow read, write: if isOwner();
      }
    }

    // Who owns the price list. The first signed-in person to publish creates this record
    // and becomes the owner. After that it cannot be replaced or deleted.
    match /site/owner {
      allow get: if request.auth != null && (resource == null || resource.data.uid == request.auth.uid);
      allow create: if isAccount()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.keys().hasOnly(['uid', 'admins']);
      allow delete: if false;
    }

    // Staff logins. Only the owner can add, change, list or remove them. A staff member can
    // read their own record, which says which shop and barber profile the login belongs to.
    match /staff/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create, update: if isOwner()
        && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'shop', 'b', 'role', 'at'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 30
        && request.resource.data.shop in ['', 'hampton-vale', 'shop-2', 'shop-3']
        && request.resource.data.b is string && request.resource.data.b.size() <= 40
        && request.resource.data.role in ['barber', 'desk']
        && request.resource.data.at is int;
      allow delete: if isOwner();
    }

    // A customer's own details: first name, email and mobile, nothing else. Only the customer
    // can write or delete them. Staff can open one customer's record (to ring someone who is
    // in the queue) but can never list customers.
    match /customers/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow list: if false;
      allow create, update: if isAccount() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'mobile', 'at', 'seen'])
        && request.resource.data.keys().hasAll(['name', 'email', 'mobile', 'at', 'seen'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 24
        && request.resource.data.email is string && request.resource.data.email == request.auth.token.email
        && request.resource.data.mobile is string && request.resource.data.mobile.matches('^[+]?[0-9]{9,15}$')
        && request.resource.data.at is int && request.resource.data.seen is int;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
